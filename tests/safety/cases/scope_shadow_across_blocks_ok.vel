# SPEC.md §6.2: "Shadowing across blocks stays legal; it is a *redeclaration in
# one scope* that is refused".  Legal twin of scope_duplicate_declaration.vel:
# the second `x` is moved into an inner block.
def main() -> None {
    x: int = 1
    if x == 1 {
        x: int = 2
        print(x)
    }
    print(x)
}
