# SPEC.md §4: "`pure def f(...) -> R` promises no side effects; required to call
# it from a `parallel for`".  Legal twin of concurrency_impure_call_refused.vel:
# the only difference is that the call is to a `pure def` instead of `print`.
pure def double(x: int) -> int {
    return x * 2
}

def main() -> None {
    mut a: Array[int, 4]
    parallel for i in range(0, 4) {
        a[i] = double(i)
    }
    print(a[3])
}
