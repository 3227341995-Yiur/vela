def main() -> None {
    mut m: int = 4
    mut n: int = 4
    mut out: Array[int, 16]
    for i in range(0, m) {
        for j in range(0, n) {
            out[i * n + j] = i + j
        }
    }
    for i in range(0, m) {
        parallel for j in range(0, n) {
            out[i * n + j] = out[i * n + j] + 1
        }
    }
    print(out[15])
}
