# `Array[S, N]`: an array whose element is a struct -- element field read, element field
# write, and a copy of an element that must not alias.  The interpreter always ran this; the
# C back end learned it from two things: the element type has to be spelled from the *packed*
# kind (`K_ST()` alone has lost the struct id), and a field of an element has to be addressed
# as a *place*, with the checked index hoisted into a statement, because a comma expression is
# an rvalue in C (`xs[1].x = 9` was C2106 before that).  Spelling the index for reads the same
# way is a wrong answer rather than a refusal: measured, `xs[0].x, xs[1].x` printed `1, 1`
# while reading through a temporary nobody had assigned.
#
# The LLVM back end still refuses this shape by name; it is `array_of_struct` in
# tests/llvm-gaps.txt with a shape beside it, which is why this case is `run-c`.
#
# Expected stdout, byte for byte:
#     1 2
#     9
#     3 7
struct Leaf {
    x: int
}

def main() -> None {
    mut xs: Array[Leaf, 3] = [Leaf(1), Leaf(2), Leaf(3)]
    print(xs[0].x, xs[1].x)

    xs[1].x = 9
    print(xs[1].x)

    mut t: Leaf = xs[2]
    t.x = 7
    print(xs[2].x, t.x)
}