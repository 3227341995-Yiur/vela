# A three-arm `match` over the elements of an array, inside a loop: every arm is reached, in
# order, and the payload arm prints its payload.  A back end that read the tag from the wrong
# place would answer with a neighbouring element's variant -- a wrong number, not a refusal.
#
# Measured before recording, on all three paths: `1 / 2 / 9`.
#
# Expected stdout, byte for byte:
#     1
#     2
#     9
enum Kind {
    A
    B
    C(n: int)
}

def main() -> None {
    mut xs: Array[Kind, 3] = [A, B, C(9)]
    mut i: int = 0
    while i < 3 {
        match xs[i] {
            C(n) {
                print(n)
            }
            B {
                print(2)
            }
            A {
                print(1)
            }
        }
        i += 1
    }
}