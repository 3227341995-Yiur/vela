# `range(n)` -- one argument, meaning `range(0, n)`.
#
# This file exists because that shape used to kill the compiler: the parser stored the
# single argument in `start` and then swapped `stop` (still -1) into it, so the loop node
# carried `stop = -1` and the dumper, both back ends and the interpreter all
# dereferenced node -1 -- 0xC000000D, no message.  `check` accepted the program, and no
# corpus file wrote a one-argument `range`, so nothing saw it until a probe measured it.
def main() -> None {
    mut total: int = 0
    for i in range(4) {
        total += i
    }
    print(total)
    mut out: Array[int, 4]
    for i in range(4) {
        out[i] = i * i
    }
    print(out[3])
    mut k: int = 0
    for i in range(0, 3) {
        k += 1
    }
    print(k)
    mut last: int = 0
    for i in range(2, 5) {
        last = i
    }
    print(last)
}