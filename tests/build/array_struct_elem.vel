# One element of an `Array[S, N]` in every position a value can be in: copied into a
# single-parameter function, passed straight out of the array, and read twice in a loop.
# The C back end learned `Array[S, N]` in 1055592; these are the shapes that come with it,
# and none of them is a new feature -- which is why they belong in the corpus rather than in
# a gap: a shape that works and is not pinned is a shape that breaks quietly.
#
# The LLVM back end still refuses the array itself (see `array_of_struct` in
# tests/llvm-gaps.txt, which is why this row is `run-c`).
#
# Expected stdout, byte for byte:
#     7
#     3
#     14
struct Leaf {
    x: int
    y: int
}

def bump(l: Leaf) -> int {
    return l.x + l.y
}

def main() -> None {
    mut xs: Array[Leaf, 2] = [Leaf(1, 2), Leaf(3, 4)]
    mut t: Leaf = xs[1]
    print(bump(t))
    print(bump(xs[0]))
    mut sum: int = 0
    mut i: int = 0
    while i < 2 {
        sum += xs[i].x * xs[i].y
        i += 1
    }
    print(sum)
}