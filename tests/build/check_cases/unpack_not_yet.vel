# `a, b = f()` -- several names from one value -- is not implemented, and this case pins
# what the compiler says now that it names the shape.
#
# Before the parser arm that produces this sentence, the statement reached the expression
# grammar and the reader got "expected a newline between statements, found ','": a complaint
# about a token, saying nothing about the construct or about what to write instead.
#
# When unpacking lands, this case moves from `refuse` to `run` and its golden becomes the
# program's output -- a deliberate change, the way `from_import_not_yet` became
# `module_from_import`.
def pair() -> int {
    return 1
}

def main() -> None {
    mut a: int = 0
    mut b: int = 0
    a, b = pair()
    print(a, b)
}
