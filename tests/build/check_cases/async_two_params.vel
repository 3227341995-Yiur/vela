# Refuse-case.  Every argument of an `async def` crosses into the thread as one word of
# the runtime's record, so in this slice the parameters are `int`s.  A `float` parameter
# is refused here, by name, rather than packed as if it were an integer -- which would
# hand the thread the bit pattern of a double and compute something wrong, quietly.
async def scale(x: float) -> int {
    return 1
}

def main() -> None {
    print(await scale(1.5))
}
