# Claim: concatenating in a loop keeps the length and the content right — the
# case that catches a result buffer that is one byte short, reused, or aliased
# with its input.  str storage is permanent memory in this language (SPEC.md 6
# rule 3), so the 100-byte result must still be equal to itself afterwards.
# Expected stdout, byte for byte:
#     100
#     True
#     8

def main() -> None {
    mut s: str = ""
    for i in range(0, 100) {
        s = s + "x"
    }
    print(len(s))
    print(s == concat(s, ""))
    mut t: str = "a"
    for i in range(0, 3) {
        t = t + t
    }
    print(len(t))
}
