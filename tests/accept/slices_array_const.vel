# Slices (ROADMAP.md item 7).  Claim: a constant-range slice of an Array[T, N] is
# an Array[T, M] whose length is the range, slicing a slice works, and writing
# the slice does not write the source — the last line is the one that decides
# whether a slice is a copy or a view, and this case asserts a copy, which is
# what `b: Array[int, 4] = a[0:4]` (the shape of the existing
# slice_not_implemented case) reads as.
#
# If v1 chooses a non-owning view instead, this file must be split: the write
# would then be visible in `a`, and `print(b[1], a[1])` would print `99 99`.
# Either answer is fine; leaving it unrecorded is not.
# Expected stdout, byte for byte:
#     0 3 4
#     5 7
#     1 2
#     1 1

def main() -> None {
    mut a: Array[int, 8] = [0, 1, 2, 3, 4, 5, 6, 7]
    b: Array[int, 4] = a[0:4]
    print(b[0], b[3], len(b))
    c: Array[int, 3] = a[5:8]
    print(c[0], c[2])
    mut d: Array[int, 2] = b[1:3]
    print(d[0], d[1])
    d[0] = 99
    print(b[1], a[1])
}
