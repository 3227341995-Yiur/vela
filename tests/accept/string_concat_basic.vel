# String concatenation (ROADMAP.md stream 2).  Claim: `+` on two str joins them,
# and the result is a real str — len, ==, and being an operand of another `+`
# all work on it.  The comparison against `concat` (the builtin that exists
# today, SPEC.md 8) is deliberate: `+` and `concat` must agree, and the empty
# string is the operand where an off-by-one length shows up.
# Expected stdout, byte for byte:
#     abcd
#     4
#     True
#     True
#     xyz

def main() -> None {
    a: str = "ab"
    b: str = "cd"
    c: str = a + b
    print(c)
    print(len(c))
    print(c == "abcd")
    print(a + "" == concat(a, ""))
    print("x" + "y" + "z")
}
