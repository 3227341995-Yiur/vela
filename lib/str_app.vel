# The run that proves `lib/str.vel`: one line per function, expected output beside it.
import str

def main() -> None {
    text3: str = concat("one\n", concat("two\n", "three"))
    print(str.int_text(0))
    print(str.int_text(42))
    print(str.int_text(0 - 7))
    print(str.to_str_f(3.25, 2))
    print(str.to_str_f(0.5, 3))
    print(str.to_str_f(0.0 - 1.5, 1))
    print(str.index_of("hello world", "world"))
    print(str.index_of("hello", "zzz"))
    print(str.count_of("banana", "an"))
    print(str.replace("a-b-c", "-", "+"))
    print(str.trim("  padded\t\n"))
    print(str.starts_with("vela.io", "vela"))
    print(str.ends_with("vela.io", ".io"))
    print(str.upper("Vela 0.1"))
    print(str.lower("Vela 0.1"))
    print(str.char_at("abc", 1))
    print(str.char_at("abc", 9))
    print(str.byte_of(65))
    print(str.parse_int("-1234"))
    print(str.parse_int("1 234"))
    print(str.repeat("ab", 3))
    print(str.pad_left("7", 3, "0"))
    print(str.hex_of(255))
    print(str.line_at(text3, 1))
    print(str.int_text(str.count_of("mississippi", "is")))

    # split / join: the storage is the caller's, the count is the answer
    mut parts: Array[str, 64]
    n: int = str.split("a,b,,c", ",", parts)
    print(str.int_text(n))
    print(parts[0])
    print(parts[1])
    print(parts[2])
    print(parts[3])
    print(str.join(parts, n, "|"))
    mut ls: Array[str, 64]
    ln: int = str.lines(text3, ls)
    print(str.int_text(ln))
    print(str.join_lines(ls, ln))
    print(str.int_text(str.split("", ",", parts)))
}
