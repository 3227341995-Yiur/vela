# Vela's string module: the operations every program reaches for, in Vela itself.
#
# There is no `int -> str` in the language and no `split`, because a dynamic array of
# strings does not exist yet -- so everything here works on byte offsets and returns
# strings, and the one operation a caller might expect (`join`) is named in the comment
# where it would have been.  Every function is exercised by `lib/str_app.vel`, which is
# the run that proves this file.

def int_text(n: int) -> str {
    if n == 0 {
        return "0"
    }
    mut v: int = n
    mut neg: bool = False
    if v < 0 {
        neg = True
        v = 0 - v
    }
    mut out: str = ""
    while v > 0 {
        d: int = v - (v // 10) * 10
        mut ch: str = "0"
        if d == 1 { ch = "1" }
        if d == 2 { ch = "2" }
        if d == 3 { ch = "3" }
        if d == 4 { ch = "4" }
        if d == 5 { ch = "5" }
        if d == 6 { ch = "6" }
        if d == 7 { ch = "7" }
        if d == 8 { ch = "8" }
        if d == 9 { ch = "9" }
        out = concat(ch, out)
        v = v // 10
    }
    if neg {
        return concat("-", out)
    }
    return out
}

# `decimals` digits after the point, rounded down.  Rounded *up* would need a carry
# through the whole integer part, which is the next version; this one is honest about
# truncating rather than pretending to round.
def to_str_f(x: float, decimals: int) -> str {
    mut v: float = x
    mut neg: bool = False
    if v < 0.0 {
        neg = True
        v = 0.0 - v
    }
    mut whole: int = 0
    while v >= 1.0 {
        v = v - 1.0
        whole += 1
    }
    mut scale: int = 1
    mut k: int = 0
    while k < decimals {
        scale = scale * 10
        k += 1
    }
    mut fracf: float = v * to_float(scale)
    mut frac: int = 0
    mut guard: int = 0
    while fracf >= 1.0 {
        fracf = fracf - 1.0
        frac += 1
        guard += 1
        if guard > 1000000 {
            fracf = 0.0
        }
    }
    mut fs: str = int_text(frac)
    # left-pad to `decimals` with zeros: 0.05 must not print as 0.5
    while len(fs) < decimals {
        fs = concat("0", fs)
    }
    mut s: str = concat(int_text(whole), ".")
    s = concat(s, fs)
    if neg {
        return concat("-", s)
    }
    return s
}

# Byte offset of `needle` in `s`, or -1.  Naive search: the strings this language has
# today are short, and a substring search that is wrong is worse than one that is slow.
def index_of(s: str, needle: str) -> int {
    if len(needle) == 0 {
        return 0
    }
    if len(needle) > len(s) {
        return 0 - 1
    }
    mut i: int = 0
    mut last: int = len(s) - len(needle)
    while i <= last {
        if substr(s, i, i + len(needle)) == needle {
            return i
        }
        i += 1
    }
    return 0 - 1
}

def count_of(s: str, needle: str) -> int {
    if len(needle) == 0 {
        return 0
    }
    mut n: int = 0
    mut from: int = 0
    while from <= len(s) - len(needle) {
        mut rest: str = substr(s, from, len(s))
        at: int = index_of(rest, needle)
        if at < 0 {
            return n
        }
        n += 1
        from = from + at + len(needle)
    }
    return n
}

def replace(s: str, needle: str, repl: str) -> str {
    if len(needle) == 0 {
        return s
    }
    mut out: str = ""
    mut from: int = 0
    while from <= len(s) - len(needle) {
        rest: str = substr(s, from, len(s))
        at: int = index_of(rest, needle)
        if at < 0 {
            break
        }
        out = concat(out, substr(s, from, from + at))
        out = concat(out, repl)
        from = from + at + len(needle)
    }
    return concat(out, substr(s, from, len(s)))
}

def is_space(b: int) -> bool {
    if b == 32 { return True }
    if b == 9 { return True }
    if b == 10 { return True }
    if b == 13 { return True }
    return False
}

def trim_left(s: str) -> str {
    mut i: int = 0
    while i < len(s) {
        if not is_space(bytes_at(s, i)) {
            return substr(s, i, len(s))
        }
        i += 1
    }
    return ""
}

def trim_right(s: str) -> str {
    mut j: int = len(s)
    while j > 0 {
        if not is_space(bytes_at(s, j - 1)) {
            return substr(s, 0, j)
        }
        j -= 1
    }
    return ""
}

def trim(s: str) -> str {
    return trim_right(trim_left(s))
}

def starts_with(s: str, p: str) -> bool {
    if len(p) > len(s) {
        return False
    }
    return substr(s, 0, len(p)) == p
}

def ends_with(s: str, p: str) -> bool {
    if len(p) > len(s) {
        return False
    }
    return substr(s, len(s) - len(p), len(s)) == p
}

def upper(s: str) -> str {
    mut out: str = ""
    mut i: int = 0
    while i < len(s) {
        b: int = bytes_at(s, i)
        if b >= 97 {
            if b <= 122 {
                out = concat(out, byte_of(b - 32))
            } else {
                out = concat(out, substr(s, i, i + 1))
            }
        } else {
            out = concat(out, substr(s, i, i + 1))
        }
        i += 1
    }
    return out
}

def lower(s: str) -> str {
    mut out: str = ""
    mut i: int = 0
    while i < len(s) {
        b: int = bytes_at(s, i)
        if b >= 65 {
            if b <= 90 {
                out = concat(out, byte_of(b + 32))
            } else {
                out = concat(out, substr(s, i, i + 1))
            }
        } else {
            out = concat(out, substr(s, i, i + 1))
        }
        i += 1
    }
    return out
}

# One byte as a one-character string.  ASCII only: a multi-byte character is two or more
# bytes, so `char_at` over non-ASCII text gives a fragment, and `chars` is what a real
# version needs.
def byte_of(b: int) -> str {
    mut table: str = ""
    table = "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"
    table = concat(table, "\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f")
    table = concat(table, " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_")
    table = concat(table, "`abcdefghijklmnopqrstuvwxyz{|}~")
    if b < 0 {
        return ""
    }
    if b >= len(table) {
        return ""
    }
    return substr(table, b, b + 1)
}

def char_at(s: str, i: int) -> str {
    if i < 0 {
        return ""
    }
    if i >= len(s) {
        return ""
    }
    return substr(s, i, i + 1)
}

def is_digit(b: int) -> bool {
    if b >= 48 {
        if b <= 57 {
            return True
        }
    }
    return False
}

# Leading '-' honoured, every other non-digit ignored (so "1 234" is 1234).  The number
# of digits is not limited: an overflow wraps like every other integer operation here.
def parse_int(s: str) -> int {
    mut v: int = 0
    mut i: int = 0
    mut neg: bool = False
    while i < len(s) {
        b: int = bytes_at(s, i)
        if i == 0 {
            if b == 45 {
                neg = True
            }
        }
        if is_digit(b) {
            v = v * 10 + (b - 48)
        }
        i += 1
    }
    if neg {
        return 0 - v
    }
    return v
}

def repeat(s: str, n: int) -> str {
    mut out: str = ""
    mut i: int = 0
    while i < n {
        out = concat(out, s)
        i += 1
    }
    return out
}

def pad_left(s: str, width: int, ch: str) -> str {
    mut out: str = s
    while len(out) < width {
        out = concat(ch, out)
    }
    return out
}

def hex_of(n: int) -> str {
    if n == 0 {
        return "0"
    }
    mut v: int = n
    mut neg: bool = False
    if v < 0 {
        neg = True
        v = 0 - v
    }
    mut out: str = ""
    while v > 0 {
        d: int = v - (v // 16) * 16
        mut ch: str = "0"
        if d == 1 { ch = "1" }
        if d == 2 { ch = "2" }
        if d == 3 { ch = "3" }
        if d == 4 { ch = "4" }
        if d == 5 { ch = "5" }
        if d == 6 { ch = "6" }
        if d == 7 { ch = "7" }
        if d == 8 { ch = "8" }
        if d == 9 { ch = "9" }
        if d == 10 { ch = "a" }
        if d == 11 { ch = "b" }
        if d == 12 { ch = "c" }
        if d == 13 { ch = "d" }
        if d == 14 { ch = "e" }
        if d == 15 { ch = "f" }
        out = concat(ch, out)
        v = v // 16
    }
    if neg {
        return concat("-", out)
    }
    return out
}

# The i-th line of `s`, splitting on '\n'.  A trailing newline does not produce an empty
# last line here, which is the one convention this file picks: `lines_count` in
# `lib/io.vel` counts it the other way.
def line_at(s: str, i: int) -> str {
    mut n: int = 0
    mut start: int = 0
    mut k: int = 0
    while k <= len(s) {
        mut at_end: bool = False
        if k == len(s) {
            at_end = True
        }
        if at_end {
            if n == i {
                return substr(s, start, k)
            }
            return ""
        }
        if bytes_at(s, k) == 10 {
            if n == i {
                return substr(s, start, k)
            }
            n += 1
            start = k + 1
        }
        k += 1
    }
    return ""
}

# Split `s` on `sep` into `out`, and answer how many pieces were written.  An array
# cannot be *returned* in this language (a returned array would point into a released
# frame), so the caller brings the storage and this fills it: `out` is a `mut` parameter
# and the count is the return value.  `shots` smaller than the number of pieces are
# dropped, which is why the return value matters rather than `len(out)`.
def split(s: str, sep: str, mut out: Array[str, 64]) -> int {
    if len(sep) == 0 {
        if len(s) > 0 {
            out[0] = s
            return 1
        }
        return 0
    }
    mut n: int = 0
    mut from: int = 0
    while from <= len(s) - len(sep) {
        rest: str = substr(s, from, len(s))
        at: int = index_of(rest, sep)
        if at < 0 {
            break
        }
        if n < 64 {
            out[n] = substr(s, from, from + at)
        }
        n += 1
        from = from + at + len(sep)
    }
    if n < 64 {
        out[n] = substr(s, from, len(s))
    }
    return n + 1
}

# Join the first `n` pieces of `parts` with `sep`.  The inverse of `split`, and the
# reason both take a count: the storage may be longer than what is live.
def join(parts: Array[str, 64], n: int, sep: str) -> str {
    mut out: str = ""
    mut i: int = 0
    while i < n {
        if i > 0 {
            out = concat(out, sep)
        }
        out = concat(out, parts[i])
        i += 1
    }
    return out
}

# The lines of a multi-line string, and back again.  A trailing newline does not
# produce a final empty line, which is `line_at`'s convention in this same file.
def lines(s: str, mut out: Array[str, 64]) -> int {
    return split(s, "\n", out)
}

def join_lines(parts: Array[str, 64], n: int) -> str {
    return join(parts, n, "\n")
}

# Lexicographic order -- the one comparison a str cannot do with an operator.  < and
# >= are refused for strings (measured: "operator '<' cannot be applied to str and str"),
# so a program that sorts names, keeps a map ordered, or checks that a key falls in a range
# has to ask for it.  The answer is the sign of the first differing byte, and the shorter
# string first when one is a prefix of the other -- strcmp's rule, returned as an int
# rather than as three boolean functions, because a caller sorting with it wants the int.
def compare(a: str, b: str) -> int {
    mut n: int = len(a)
    if len(b) < n {
        n = len(b)
    }
    mut i: int = 0
    while i < n {
        ca: int = bytes_at(a, i)
        cb: int = bytes_at(b, i)
        if ca < cb {
            return 0 - 1
        }
        if ca > cb {
            return 1
        }
        i += 1
    }
    if len(a) < len(b) {
        return 0 - 1
    }
    if len(a) > len(b) {
        return 1
    }
    return 0
}

def lt(a: str, b: str) -> bool {
    return compare(a, b) < 0
}

def gt(a: str, b: str) -> bool {
    return compare(a, b) > 0
}

# The smaller of two strings, for the callers that want a value and not a sign.
def min_str(a: str, b: str) -> str {
    if compare(a, b) <= 0 {
        return a
    }
    return b
}

def max_str(a: str, b: str) -> str {
    if compare(a, b) >= 0 {
        return a
    }
    return b
}
# Searching from a place, and searching backwards -- the two shapes index_of cannot do,
# and the two a parser reaches for first: "the next field after this one" and "the last
# segment of this path".  Both answer -1 when there is nothing to find, like index_of,
# so a caller checks one condition instead of remembering two conventions.
def index_of_from(s: str, needle: str, from: int) -> int {
    n: int = len(needle)
    if n == 0 {
        return 0 - 1
    }
    mut i: int = from
    if i < 0 {
        i = 0
    }
    while i + n <= len(s) {
        if substr(s, i, i + n) == needle {
            return i
        }
        i += 1
    }
    return 0 - 1
}

# The last occurrence, found by scanning backwards and stopping at the first match: a
# forward scan would have to remember every hit it passed.
def last_index_of(s: str, needle: str) -> int {
    n: int = len(needle)
    if n == 0 {
        return 0 - 1
    }
    mut i: int = len(s) - n
    while i >= 0 {
        if substr(s, i, i + n) == needle {
            return i
        }
        i -= 1
    }
    return 0 - 1
}

# Everything after the last sep, or the whole string when sep is not there: the shape
# a path's file name and a dotted name's last component both want.
def after_last(s: str, sep: str) -> str {
    at: int = last_index_of(s, sep)
    if at < 0 {
        return s
    }
    return substr(s, at + len(sep), len(s))
}

# Everything before the last sep, or "" when it is not there.
def before_last(s: str, sep: str) -> str {
    at: int = last_index_of(s, sep)
    if at < 0 {
        return ""
    }
    return substr(s, 0, at)
}