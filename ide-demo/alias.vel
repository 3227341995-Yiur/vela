# alias.vel -- `from geometry import area as area2`: the imported name gets a local one,
# and every `area2` in this file *is* `geometry`'s `area`.
#
# The rebinding happens once, when the file is loaded: the parser records the pair on the
# import statement and the loader rewrites this file's references after it has renamed
# colliding names across files.  Two consequences worth knowing in the editor:
#
#   * the alias is per file -- another file that imports `geometry` is unaffected;
#   * a file may hold as many aliases as it writes: the pairs are a chain on the import
#     statement, and the test that says so is `tests/build/modules/two_aliases.vel`.
#
# Prints the same number as `modules.vel`'s first line, because it is the same call.
from geometry import area as area2

def main() -> None {
    print(area2(3, 4))
}
