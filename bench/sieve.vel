def main() -> None {
    mut n: int = 20000000
    mut comp: Array[u8, 20000000] = [0]
    t0: float = now()
    mut i: int = 2
    while i * i < n {
        if comp[i] == 0 {
            mut j: int = i * i
            while j < n {
                comp[j] = 1
                j += i
            }
        }
        i += 1
    }
    t1: float = now()
    mut count: int = 0
    for k in range(2, n) {
        if comp[k] == 0 {
            count += 1
        }
    }
    print("primes", count)
    print("seconds", t1 - t0)
}
