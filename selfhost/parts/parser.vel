# ---------------------------------------------------------------------------
# selfhost/parts/parser.vel — the parse stage, written in Vela.
#
# This file is one part of the self-hosted front end.  Vela has no module *loader*
# yet (`import` became a keyword at MODULES_PLAN.md step 1 and the loader is step 2,
# so the word is claimed but the statement is refused by name), so
# `tools/link_selfhost.vel` splices the parts together with the lexer into
# `selfhost/vm.vel` — the compiler still compiles exactly one file.  That is the
# same trick C plays with #include, and it disappears the day step 2 lands.  The
# linker used to be `tools/link_selfhost.py`; it is written in Vela now.
#
# ---------------------------------------------------------------------------
# Node record — 10 ints per node, nd[i * 10 + k]:
#
#   0 kind    1 a     2 b     3 c     4 d
#   5 line    6 flags 7 nx    8 e     9 f
#
# `nx` links a node to the next node in whatever chain it belongs to (a
# statement list, a parameter list, an argument list, an element list) or -1.
# Chains are linked instead of packed because a statement list is parsed
# *around* its nested blocks: the nested statements are appended to the same
# pool in between, so a contiguous run would only work for expressions.
#
# kind  1 module      a=first stmt  b=count
# kind  2 def         a=name  b=ret type  c=first param  d=param count
#                     e=first stmt  f=stmt count    flags: 4 = pure
# kind  3 param       a=name  b=type                 flags: 1 = mut
# kind  4 struct      a=name  b=first stmt  c=stmt count (fields and methods)
# kind  5 field       a=name  b=type
# kind  6 assign      a=target  b=value(-1)  c=declared type(-1)
#                     flags: 1 = mut, 2 = a declaration
# kind  7 augassign   a=target  b=value  c=base operator
# kind  8 expr        a=value
# kind  9 return      a=value(-1)
# kind 10 if          a=cond  b=then first  c=then count  d=else first  e=else count
# kind 11 while       a=cond  b=first  c=count
# kind 12 for         a=var name  b=start  c=stop  d=step(-1)
#                     e=first stmt  f=stmt count    flags: 1 = parallel
# kind 13 break       14 continue      15 pass
# kind 20 int         a=value
# kind 21 float       a=index into the float pool  b=offset  c=length
# kind 22 str         a=offset  b=length           flags: 1 = literal has escapes
# kind 23 bool        a=0 or 1
# kind 24 none
# kind 25 name        a=name handle
# kind 26 call        a=callee  b=first arg  c=arg count
# kind 27 binop       a=op  b=left  c=right
# kind 28 unary       a=op  b=operand
# kind 29 boolop      a=op (13 and, 14 or)  b=left  c=right
# kind 30 cmp         a=op  b=left  c=right
# kind 31 index       a=value  b=index
# kind 32 attr        a=value  b=name handle
# kind 33 list        a=first elem  b=elem count
# kind 34 slice       a=value  b=lower(-1)  c=upper(-1)
# kind 35 enum        a=name  b=first variant  c=variant count
# kind 36 variant     a=name  b=first field  c=field count      (fields = kind 3)
# kind 37 match       a=subject  b=first arm  c=arm count
# kind 38 arm         a=pattern name(-1 = else)  b=first binding  c=binding count
#                     d=body first  e=body count   (bindings = kind 25)
# kind 40 import      a=offset  b=length           flags: 1 = literal has escapes
# kind 42 defer       a=block first  b=block count  c=0 defer, 1 errdefer
#
# kind 42 is a *record*, not a statement: the `defer` statement itself becomes a
# `pass`, and the record is what `parse_funcdef` reads when the body is complete —
# the block is appended to the end of the body and hung off every `return`'s slot 8.
# Nothing else walks it, which is why it is the one kind with no arms in resolve,
# check, dump or either back end.
#
# kind 40 is the one node the *driver* consumes rather than the resolver: it is
# the only statement that is not part of the program, it is part of how the
# program was assembled (MODULES_PLAN.md step 2), so `resolve_module` never sees
# it — the loader strips it out while it splices the files together.  It stores
# its path exactly as a `str` node (kind 22) stores its text, because the loader
# makes the path out of the same two readings: `substr` and `unescape`.
#
# ---------------------------------------------------------------------------
# Type record — 4 ints per type, ty[i * 4 + k]:
#
#   0 kind (1 named)  1 name handle  2 element type (-1)  3 length (-1)
#
# `Array[int, 8]` is a named type whose name handle is "Array", whose element
# slot holds `int` and whose length slot holds 8; every other type leaves slots
# 2 and 3 at -1.
#
# ---------------------------------------------------------------------------
# Ctx carries every cursor the stages need.  The lexer leaves `pos`, `line` and
# `aux` behind, and the parser reuses them:
#
#   cx.ti     token cursor
#   cx.ni     node cursor
#   cx.sp     type pool cursor
#   cx.fp     float literal pool cursor
#   cx.rslot  out-parameter: how many items the chain just parsed has
#   cx.aux    loop depth, so 'break' outside a loop is refused (the lexer's use
#             of it as a bracket depth is over by then)
#
# Names are compared as *handles*: `intern` is content addressed, so equal
# spellings get equal ints and the parser never has to compare strings.

# `vela: <kind>: <message>`, the shape stage 0's diagnostics have and the shape
# `tests/diff_check.py` reads a verdict out of.  A parser can raise a type error
# (`slices are not implemented`) as easily as a syntax error, so the kind is a
# parameter rather than a constant, and the location is a second line for the
# same reason `ck_type`/`ck_safety` put it there: the message is what is compared.
def perr_kind(mut cx: Ctx, kind: str, msg: str, line: int) -> None {
    if cx.err == 0 {
        cx.err = 1
        warn_str("vela: ")
        warn_str(kind)
        warn_str(": ")
        warn_str(msg)
        warn_str("\n  at line ")
        warn_int(line)
        warn_nl()
    }
}

def perr(mut cx: Ctx, msg: str, line: int) -> None {
    perr_kind(cx, "syntax error", msg, line)
}

# A keyword standing where a NAME was expected, and it is `import` that needs saying out loud.
#
# `import` was an ordinary identifier in 0.1 -- `SPEC.md` 1.3 gave `mut import: int = 1` as the
# example of a legal declaration and promised that "a program that uses them as names will need
# renaming the day one arrives".  That day is MODULES_PLAN.md step 1, and the program it happens
# to is a case in this tree (`tests/accept/modules/module_import_reserved_name.vel`), so the
# refusal is a *reported* cost rather than a discovery: "expected a variable name after 'mut'"
# would be true, unhelpful, and would leave the reader to guess which of the two things changed.
#
# Returns True when it reported, so each call site reads as one `if` above its generic message.
def kw_as_name(tk: Array[int, 1572864], mut cx: Ctx, line: int) -> bool {
    if at_kw(tk, cx, 26) {
        mut msg: str = concat("`import` is a keyword since MODULES_PLAN.md step 1 (SPEC.md 1.3",
                             " reserves it for the module system), so it is not a name here")
        msg = concat(msg, " -- rename this binding")
        perr_kind(cx, "syntax error", msg, line)
        return True
    }
    return False
}

# Is the token `k` ahead of the cursor a NAME spelled `word`?  `from` and `as`
# stay ordinary identifiers until MODULES_PLAN.md step 6 claims them, so the
# spelling has to be recognised *by looking ahead* rather than by a keyword id:
# `from = 1` is a legal assignment today and must stay one.
def name_ahead(src: str, tk: Array[int, 1572864], cx: Ctx, k: int, word: str) -> bool {
    if tk_kind(tk, cx.ti + k) != 1 {
        return False
    }
    if tk_ival(tk, cx.ti + k) != 0 {
        return False
    }
    return name_eq(src, tk_off(tk, cx.ti + k), tk_len(tk, cx.ti + k), word)
}

# The token under the cursor, spelled the way the reader wrote it.  Stage 0
# quotes it (`found 'mut'`), and an offset plus a length is all that takes: the
# parser owns `src` and the lexer already recorded both.
def tok_text(src: str, tk: Array[int, 1572864], cx: Ctx) -> str {
    o: int = tk_off(tk, cx.ti)
    mut e: int = o + tk_len(tk, cx.ti)
    # the end-of-file token sits at the end of the text with no length, and a
    # span that ran past it would index the string, not quote it
    if e > len(src) {
        e = len(src)
    }
    if o > e {
        return ""
    }
    return substr(src, o, e)
}

def new_node(mut nd: Array[int, 1310720], mut cx: Ctx, kind: int, line: int) -> int {
    n: int = cx.ni
    # The node pool is the compiler's own ceiling and this is where it is reached:
    # it grew from 65536 to 131072 when the front end outgrew the old one (the
    # linked compiler needs ~66 600 nodes for its own source, measured when
    # `parse selfhost/vm.vel` first refused at line 18 663 of 18 966).  The
    # *node table*, which is indexed by this same number, moved into the arena's
    # unallocated middle at the same time -- see `MEM_NT` in vm_state.vel.
    #
    # The refusal then *stops*: `panic`, not a bare `return -1`.  Returning -1 is
    # what the callers cannot survive -- `nd[n4 * 10 + 1] = nm` with n4 == -1 is
    # `nd[-9]`, and the measured behaviour of that is not a crash and not an exit:
    # the compiler prints this diagnostic and then blocks forever with no exit
    # code (a small generated file that trips the ceiling reproduces it in
    # seconds).  A refusal that hangs is worse than a refusal that stops, because
    # nothing reading the exit code can tell it from work still in progress.
    if n >= 131072 {
        perr(cx, "this file has too many syntax nodes", line)
        panic("this file has too many syntax nodes")
    }
    i: int = n * 10
    nd[i] = kind
    nd[i + 1] = 0
    nd[i + 2] = 0
    nd[i + 3] = 0
    nd[i + 4] = 0
    nd[i + 5] = line
    nd[i + 6] = 0
    nd[i + 7] = -1
    nd[i + 8] = 0
    nd[i + 9] = 0
    cx.ni += 1
    return n
}

# ---------------------------------------------------------------------------
# token cursor

def ti_kind(tk: Array[int, 1572864], cx: Ctx) -> int {
    return tk_kind(tk, cx.ti)
}

def ti_val(tk: Array[int, 1572864], cx: Ctx) -> int {
    return tk_ival(tk, cx.ti)
}

def ti_line(tk: Array[int, 1572864], cx: Ctx) -> int {
    return tk_line(tk, cx.ti)
}

def at_op(tk: Array[int, 1572864], cx: Ctx, op: int) -> bool {
    return tk_kind(tk, cx.ti) == 5 and tk_ival(tk, cx.ti) == op
}

def at_op2(tk: Array[int, 1572864], cx: Ctx, k: int, op: int) -> bool {
    return tk_kind(tk, cx.ti + k) == 5 and tk_ival(tk, cx.ti + k) == op
}

def at_kw(tk: Array[int, 1572864], cx: Ctx, kw: int) -> bool {
    return tk_kind(tk, cx.ti) == 1 and tk_ival(tk, cx.ti) == kw
}

def at_name(tk: Array[int, 1572864], cx: Ctx) -> bool {
    return tk_kind(tk, cx.ti) == 1 and tk_ival(tk, cx.ti) == 0
}

def at_eof(tk: Array[int, 1572864], cx: Ctx) -> bool {
    return tk_kind(tk, cx.ti) == 9
}

def at_nl(tk: Array[int, 1572864], cx: Ctx) -> bool {
    return tk_kind(tk, cx.ti) == 6
}

# the end of a block, or the end of the file
def at_close(tk: Array[int, 1572864], cx: Ctx) -> bool {
    return at_op(tk, cx, 34) or at_eof(tk, cx)
}

def name_id(src: str, tk: Array[int, 1572864], cx: Ctx) -> int {
    return intern(substr(src, tk_off(tk, cx.ti),
                         tk_off(tk, cx.ti) + tk_len(tk, cx.ti)))
}

# ---------------------------------------------------------------------------
# operator tables.  The codes are the lexer's: one numbering for the whole front
# end, so an operator never has to be spelled as a string at run time.

def is_aug(tk: Array[int, 1572864], cx: Ctx) -> bool {
    if tk_kind(tk, cx.ti) != 5 {
        return False
    }
    v: int = tk_ival(tk, cx.ti)
    if v == 27 or v == 28 or v == 29 or v == 30 or v == 31 {
        return True
    }
    if v == 37 or v == 38 or v == 39 or v == 40 or v == 41 {
        return True
    }
    return v == 42 or v == 43
}

# `+=` is parsed into the `+` it stands for, so the interpreter has one node
# kind to run instead of twelve
def aug_base(op: int) -> int {
    if op == 27 {
        return 1
    }
    if op == 28 {
        return 2
    }
    if op == 29 {
        return 3
    }
    if op == 30 {
        return 4
    }
    if op == 31 {
        return 5
    }
    if op == 37 {
        return 35
    }
    if op == 38 {
        return 36
    }
    if op == 39 {
        return 17
    }
    if op == 40 {
        return 18
    }
    if op == 41 {
        return 19
    }
    if op == 42 {
        return 21
    }
    return 20
}

def is_cmp_op(tk: Array[int, 1572864], cx: Ctx) -> bool {
    if tk_kind(tk, cx.ti) != 5 {
        return False
    }
    v: int = tk_ival(tk, cx.ti)
    return v == 6 or v == 7 or v == 22 or v == 23 or v == 24 or v == 25
}

# ---------------------------------------------------------------------------
# pools

def flt_add(mut flt: Array[float, 262144], mut cx: Ctx, v: float, line: int) -> int {
    i: int = cx.fp
    if i >= 65536 {
        perr(cx, "this file has too many float literals", line)
        return 0
    }
    flt[i] = v
    cx.fp += 1
    return i
}

def ty_add(mut ty: Array[int, 262144], mut cx: Ctx, name: int, elem: int,
           size: int, line: int) -> int {
    i: int = cx.sp
    if i >= 65536 {
        perr(cx, "this file has too many type annotations", line)
        return -1
    }
    ty[i * 4] = 1
    ty[i * 4 + 1] = name
    ty[i * 4 + 2] = elem
    ty[i * 4 + 3] = size
    cx.sp += 1
    return i
}

# ---------------------------------------------------------------------------
# types

def parse_type(src: str, tk: Array[int, 1572864], mut ty: Array[int, 262144],
               mut cx: Ctx) -> int {
    if cx.err != 0 {
        return -1
    }
    line: int = ti_line(tk, cx)
    if at_kw(tk, cx, 18) {
        cx.ti += 1
        return ty_add(ty, cx, intern("None"), -1, -1, line)
    }
    if at_op(tk, cx, 9) {
        # `(int, str) -> bool`: a *function type*, which is the type of a value that
        # names a function -- a parameter (`def apply(g: (int) -> int, x: int)`), a
        # binding, or a result.  There is no other production that starts with `(`
        # in type position, so this arm is unambiguous.
        #
        # The layout is fixed here and read by `ty_fret`/`ty_farity`/`ty_fparam`
        # (vm_state.vel): the signature record is allocated first, and then one
        # record per parameter *immediately after it*, which is what makes the
        # parameter types reachable as `t + 1 + j` with no second table and no new
        # region in `mem`.  Sixteen parameters is this spelling's limit, and a
        # refusal naming it is better than a type that quietly drops the
        # seventeenth.
        cx.ti += 1
        mut ptys: Array[int, 16]
        mut np: int = 0
        if not at_op(tk, cx, 10) {
            while cx.err == 0 {
                if np >= 16 {
                    perr(cx, "a function type takes at most sixteen parameter types", ti_line(tk, cx))
                    return -1
                }
                ptys[np] = parse_type(src, tk, ty, cx)
                if cx.err != 0 {
                    return -1
                }
                np += 1
                if at_op(tk, cx, 11) {
                    cx.ti += 1
                    continue
                }
                break
            }
        }
        if not at_op(tk, cx, 10) {
            perr(cx, "expected ')' after the parameter types of a function type", ti_line(tk, cx))
            return -1
        }
        cx.ti += 1
        if not at_op(tk, cx, 26) {
            perr(cx, "expected '->' and a result type after a function type's parameter list", ti_line(tk, cx))
            return -1
        }
        cx.ti += 1
        ret: int = parse_type(src, tk, ty, cx)
        if cx.err != 0 {
            return -1
        }
        t: int = ty_add(ty, cx, intern("fn"), ret, np, line)
        mut i: int = 0
        while i < np {
            ty_add(ty, cx, ptys[i], -1, -1, line)
            i += 1
        }
        return t
    }
    if not at_name(tk, cx) {
        perr(cx, "expected a type name", line)
        return -1
    }
    base: int = name_id(src, tk, cx)
    cx.ti += 1
    # `result.Result` -- a module-qualified *type* name.  After the modules are merged a
    # program has one type namespace, so the qualifier is decoration and the last
    # component is the name: the same rule `import vela.io` follows when it binds `io`.
    # Per-module type namespaces would be a bigger feature than this spelling, and are
    # not claimed here.
    mut last: int = base
    while at_op(tk, cx, 13) {
        cx.ti += 1
        if not at_name(tk, cx) {
            perr(cx, "expected a type name after '.'", ti_line(tk, cx))
            return -1
        }
        last = name_id(src, tk, cx)
        cx.ti += 1
    }
    mut elem: int = -1
    mut size: int = -1
    if at_op(tk, cx, 14) {
        cx.ti += 1
        elem = parse_type(src, tk, ty, cx)
        if cx.err != 0 {
            return -1
        }
        if at_op(tk, cx, 11) {
            cx.ti += 1
            if tk_kind(tk, cx.ti) != 2 {
                perr(cx, "expected a compile-time array length", ti_line(tk, cx))
                return -1
            }
            size = ti_val(tk, cx)
            cx.ti += 1
        }
        if not at_op(tk, cx, 15) {
            perr(cx, "expected ']' to close the type", ti_line(tk, cx))
            return -1
        }
        cx.ti += 1
    }
    return ty_add(ty, cx, last, elem, size, line)
}

# ---------------------------------------------------------------------------
# statement lists

def end_of_stmt(src: str, tk: Array[int, 1572864], mut cx: Ctx) -> None {
    if cx.err != 0 {
        return
    }
    if at_nl(tk, cx) {
        cx.ti += 1
        return
    }
    if at_op(tk, cx, 34) {
        return
    }
    if at_eof(tk, cx) {
        return
    }
    perr(cx, concat(concat("expected a newline between statements, found '",
                           tok_text(src, tk, cx)), "'"), ti_line(tk, cx))
}

# Consumes '{' statements '}' and returns the first statement of the chain.
# The number of statements is left in cx.rslot, because a Vela function has
# exactly one return value and threading a second one through a pool would be
# worse than one documented out-parameter.
def parse_body(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
               mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
               mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    cx.rslot = 0
    if cx.err != 0 {
        return -1
    }
    if not at_op(tk, cx, 33) {
        perr(cx, concat(concat("expected '{' to open a block, found '",
                               tok_text(src, tk, cx)), "'"), ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    mut head: int = -1
    mut tail: int = -1
    mut count: int = 0
    # How deep the blocks are: a `defer` is only legal at depth 1, i.e. written
    # directly in a function body -- see `parse_defer`.  Counted here rather than in
    # `parse_if`/`parse_while`/`parse_for`/`parse_match` because every block in this
    # language goes through this one function, and one counter cannot drift from
    # four call sites.
    cx.bdepth += 1
    while cx.err == 0 and not at_close(tk, cx) {
        if at_nl(tk, cx) {
            cx.ti += 1
            continue
        }
        s: int = parse_stmt(src, tk, tkf, nd, ty, flt, cx, 0)
        if s >= 0 {
            if head < 0 {
                head = s
            } else {
                nd[tail * 10 + 7] = s
            }
            tail = s
            count += 1
        }
        if cx.err != 0 {
            break
        }
        end_of_stmt(src, tk, cx)
    }
    cx.bdepth -= 1
    if cx.err != 0 {
        return head
    }
    if at_eof(tk, cx) {
        perr(cx, "missing '}': a block is never closed", ti_line(tk, cx))
        return head
    }
    cx.ti += 1
    cx.rslot = count
    return head
}

def is_name_at(tk: Array[int, 1572864], cx: Ctx, k: int) -> bool {
    return tk_kind(tk, cx.ti + k) == 1 and tk_ival(tk, cx.ti + k) == 0
}

def is_kw_at(tk: Array[int, 1572864], cx: Ctx, k: int, id: int) -> bool {
    return tk_kind(tk, cx.ti + k) == 1 and tk_ival(tk, cx.ti + k) == id
}

# `tok_text` for a token `k` ahead of the cursor, so a refusal can quote the token
# it is about without moving `cx.ti` first.
def tok_text_at(src: str, tk: Array[int, 1572864], cx: Ctx, k: int) -> str {
    o: int = tk_off(tk, cx.ti + k)
    mut e: int = o + tk_len(tk, cx.ti + k)
    if e > len(src) {
        e = len(src)
    }
    if o > e {
        return ""
    }
    return substr(src, o, e)
}

# `from M import x` is a NAME followed by a NAME followed by the `import` keyword.
# It is recognised by that *shape* rather than by a keyword, because `from` and
# `as` are ordinary identifiers until MODULES_PLAN.md step 6 claims them: `from = 1`
# is a legal assignment today, and a lookahead of three tokens is the only thing
# that tells the two apart.  Top level only, because that is where the corpus
# writes it (`tests/accept/modules/module_import_from.vel`).
def at_from_import_shape(src: str, tk: Array[int, 1572864], cx: Ctx, top: int) -> bool {
    if top != 1 {
        return False
    }
    if not at_name(tk, cx) {
        return False
    }
    if not name_ahead(src, tk, cx, 0, "from") {
        return False
    }
    if not is_name_at(tk, cx, 1) {
        return False
    }
    return is_kw_at(tk, cx, 2, 26)
}

# "The `import` line ends here" as one boolean, rather than `at_eof(...) or
# at_nl(...)` written inline.
#
# It is one function for a measured reason: with the two-call `or` inline in
# `parse_import`, the LLVM back end refuses to build the compiler itself ("vela:
# llvm: adding an argument:" then "the LLVM back end could not build this
# program"), while the same program through the C back end and through the
# interpreter is fine.  The identical shape in a small standalone program builds,
# so what decides it is the size of the program, not the shape; the defect is
# recorded in MODULES_STEP1.md rather than hidden here.  Splitting the `or` into a
# function the emitter calls once keeps step 1 landing on a green build.
def at_import_end(tk: Array[int, 1572864], cx: Ctx) -> bool {
    if at_eof(tk, cx) {
        return True
    }
    return at_nl(tk, cx)
}

# `import` in statement position.  The spelling is `import "path/file.vel"` (D1),
# and this function's whole job is to turn that line into one node (kind 40) that
# carries the path's span: *reading* the file it names is the driver's job
# (`load_file` in `vm_main.vel`), because a parser that opens files cannot be run
# on a file it was not given.
#
# Three shapes, three sentences, and only the first one is code:
#
#   * `import "b.vel"` — the node, and the loader does the rest;
#   * `import mathlib` — a bare name needs a search rule, which is step 6, so it is
#     refused with the spelling that works today;
#   * an `import` inside a block — a declaration of the file in the wrong place.
def parse_import(src: str, tk: Array[int, 1572864], mut nd: Array[int, 1310720],
                 mut cx: Ctx, line: int, top: int) -> int {
    if top != 1 {
        perr(cx,
             "`import` declares what the file uses, so it belongs at the top level, outside every block",
             line)
        return -1
    }
    cx.ti += 1
    if at_import_end(tk, cx) {
        perr(cx, "expected a module name after `import`: write `import geometry` or `import vela.io`", line)
        return -1
    }
    if tk_kind(tk, cx.ti) == 4 {
        # `import "path.vel"` was the first spelling (MODULES_PLAN.md D1) and is gone:
        # a module is named by a name, and the search rule that name implies is the
        # whole point of having modules.  The refusal quotes the path so a reader
        # migrating an old file sees exactly which token to replace.
        perr_kind(cx, "syntax error",
                  concat(concat("`import \"",
                                substr(src, tk_off(tk, cx.ti),
                                       tk_off(tk, cx.ti) + tk_len(tk, cx.ti))),
                         "\"`: a path is not a module name -- write `import geometry` (and `import vela.io` for a package)"),
                  line)
        return -1
    }
    if not at_name(tk, cx) {
        perr(cx, "expected a module name after `import`: write `import geometry` or `import vela.io`", line)
        return -1
    }
    # A dotted name, the way Python spells a package path: `geometry`, `vela.io`,
    # `vela.io.files`.  The span is the whole thing, dots included, so the dump prints
    # what the reader wrote and the loader is the only place that knows a dot is also a
    # directory separator.
    off: int = tk_off(tk, cx.ti)
    mut end: int = off + tk_len(tk, cx.ti)
    cx.ti += 1
    while at_op(tk, cx, 13) {
        cx.ti += 1
        if not at_name(tk, cx) {
            perr(cx, "expected a module name after '.' in this `import`", line)
            return -1
        }
        end = tk_off(tk, cx.ti) + tk_len(tk, cx.ti)
        cx.ti += 1
    }
    # `as` is an identifier, not a keyword (SPEC.md 1.3 says so on purpose: it keeps the
    # word usable as a name), so the alias is recognised by its text.
    mut aoff: int = 0
    mut alen: int = 0
    if at_name(tk, cx) {
        if tok_text(src, tk, cx) == "as" {
            cx.ti += 1
            if not at_name(tk, cx) {
                perr(cx, "expected a name after `as`", line)
                return -1
            }
            aoff = tk_off(tk, cx.ti)
            alen = tk_len(tk, cx.ti)
            cx.ti += 1
        }
    }
    n: int = new_node(nd, cx, 40, line)
    nd[n * 10 + 1] = off
    nd[n * 10 + 2] = end - off
    nd[n * 10 + 3] = aoff
    nd[n * 10 + 4] = alen
    nd[n * 10 + 6] = 0
    nd[n * 10 + 8] = 0
    return n
}

# ---------------------------------------------------------------------------
# statements

# `defer { ... }` -- a block that runs when the function it is written in is left.
#
# The parser is where this lives because both ways out of a function are parser
# facts: the block is **appended to the end of the function body** (so resolve,
# check, both back ends and the interpreter's fall-through all see one ordinary
# statement list, walked once and slot-assigned once), and the same statements are
# **hung off every `return` node's slot 8** (so an early return runs them too, after
# the value has been computed).  A body that ends in a `return` runs them through
# slot 8 only; the appended copy is then unreachable, which is what a dead statement
# is, and the LLVM back end opens its "dead" block for exactly that case.
#
# Three rules, each a refusal instead of a wrong answer:
#   * a `defer` belongs to a function body -- not to a file's top level, not to a
#     struct body, and not to another `defer`;
#   * not inside a loop: the block is registered once, statically, so a `defer` in a
#     loop would run once after a loop that ran a thousand times;
#   * `return`, `break` and `continue` may not appear in the block itself: a cleanup
#     that leaves the function through another door would skip every cleanup that is
#     still pending.
def parse_defer(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                mut flt: Array[float, 262144], mut cx: Ctx, line: int,
                iserr: int) -> int {
    cx.ti += 1
    if cx.fndef == 0 {
        perr(cx, "a `defer` belongs to a function body", line)
        return -1
    }
    if cx.aux > 0 {
        perr(cx, "a `defer` may not appear inside a loop: it registers once, so it would run once after a loop that ran many times -- move it out of the loop", line)
        return -1
    }
    if cx.bdepth != 1 {
        perr(cx, "a `defer` must be written directly in the function body: a `defer` inside a conditional block runs even when the block did not -- move it up, and let it check what it needs", line)
        return -1
    }
    if not at_op(tk, cx, 33) {
        perr(cx, "a `defer` needs a block: write `defer { ... }`", line)
        return -1
    }
    mut saved: int = cx.indef
    cx.indef = 1
    first: int = parse_body(src, tk, tkf, nd, ty, flt, cx)
    cnt: int = cx.rslot
    cx.indef = saved
    if cx.err != 0 {
        return -1
    }
    rec: int = new_node(nd, cx, 42, line)
    nd[rec * 10 + 1] = first
    nd[rec * 10 + 2] = cnt
    nd[rec * 10 + 3] = iserr
    # most recent first: the chain is the order the cleanups have to run in.  The
    # two kinds are two chains, because one of them runs only on the error path.
    if iserr == 1 {
        nd[rec * 10 + 7] = cx.efirst
        cx.efirst = rec
    } else {
        nd[rec * 10 + 7] = cx.dfirst
        cx.dfirst = rec
    }
    return new_node(nd, cx, 15, line)
}

# The defer blocks as one statement list, most recent first.  Each block is an
# independent chain, so this links the last statement of one to the first of the
# next; done once, after the body is parsed, because the links are the same for
# every exit.
def defers_chain(mut nd: Array[int, 1310720], head: int) -> int {
    mut first: int = -1
    mut tail: int = -1
    mut r: int = head
    while r > 0 {
        st: int = nd[r * 10 + 1]
        if st > 0 {
            if first < 0 {
                first = st
            } else {
                nd[tail * 10 + 7] = st
            }
            mut t: int = st
            while nd_nx(nd, t) > 0 {
                t = nd_nx(nd, t)
            }
            tail = t
        }
        r = nd_nx(nd, r)
    }
    return first
}

def defers_count(nd: Array[int, 1310720], head: int) -> int {
    mut n0: int = 0
    mut r: int = head
    while r > 0 {
        n0 += nd[r * 10 + 2]
        r = nd_nx(nd, r)
    }
    return n0
}

# Hang the cleanup list off every `return` in this body -- including the ones a
# reader forgets, inside `if`, `while`, `for` and a `match` arm.  Slot 8 of a
# `return` is read by all three paths and by nothing else.
def defers_stamp(mut nd: Array[int, 1310720], first: int, dchain: int,
                 echain: int) -> None {
    mut s: int = first
    while s > 0 {
        k: int = nd_kind(nd, s)
        if k == 9 {
            nd[s * 10 + 8] = dchain
            nd[s * 10 + 9] = echain
        } else if k == 10 {
            defers_stamp(nd, nd[s * 10 + 2], dchain, echain)
            defers_stamp(nd, nd[s * 10 + 4], dchain, echain)
        } else if k == 11 {
            defers_stamp(nd, nd[s * 10 + 2], dchain, echain)
        } else if k == 12 {
            defers_stamp(nd, nd[s * 10 + 5], dchain, echain)
        } else if k == 37 {
            mut a: int = nd[s * 10 + 2]
            while a > 0 {
                defers_stamp(nd, nd[a * 10 + 4], dchain, echain)
                a = nd_nx(nd, a)
            }
        }
        s = nd_nx(nd, s)
    }
}

def parse_stmt(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
               mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
               mut flt: Array[float, 262144], mut cx: Ctx, top: int) -> int {
    if cx.err != 0 {
        return -1
    }
    line: int = ti_line(tk, cx)
    # `import` is keyword 26 as of MODULES_PLAN.md step 1 (vela.vel's keyword_id), and it is
    # recognised here, above every expression and assignment arm, so the shape `import "b.vel"`
    # never reaches the expression grammar: before this arm existed it came out as "expected a
    # newline between statements, found 'b.vel'" -- a complaint about the string that says
    # nothing about the construct.  `top` separates the two positions the same token can be in:
    # a declaration of the file (top level) and a statement in the wrong place (any block).
    if at_kw(tk, cx, 26) {
        return parse_import(src, tk, nd, cx, line, top)
    }
    # The corpus's other spelling, `from mathlib import add`.  Its own step is 6; what this arm
    # owes today is a refusal that names the shape instead of the token after it, which is what
    # `tests/accept/modules/module_import_from.vel` and `module_import_missing.vel` record.
    if at_from_import_shape(src, tk, cx, top) {
        nm: str = tok_text_at(src, tk, cx, 1)
        mut fmsg: str = concat("`from ", nm)
        fmsg = concat(fmsg, " import x` is MODULES_PLAN.md step 6: `from` and `as` are ordinary")
        fmsg = concat(fmsg, " identifiers until then, so the spelling today is a path string --")
        fmsg = concat(fmsg, " write `import <path>/<name>.vel`")
        perr_kind(cx, "syntax error", fmsg, line)
        return -1
    }
    if at_kw(tk, cx, 20) {
        cx.ti += 1
        if not at_kw(tk, cx, 1) {
            perr(cx, "'pure' must be followed by a function definition", line)
            return -1
        }
        return parse_funcdef(src, tk, tkf, nd, ty, flt, cx, 4)
    }
    if at_kw(tk, cx, 1) {
        return parse_funcdef(src, tk, tkf, nd, ty, flt, cx, 0)
    }
    if at_kw(tk, cx, 23) {
        # `extern c def puts(s: str) -> None` — a *declaration*, not a
        # definition: it says a C library function exists and what its C
        # prototype is, and Vela emits that prototype and the call.  There is no
        # header to name, because the declaration *is* the prototype; and there
        # is no body, which is what flag 8 means to the resolver and the emitter.
        cx.ti += 1
        if not at_name(tk, cx) {
            perr(cx, "expected 'c' after 'extern'", line)
            return -1
        }
        if not name_eq(src, tk_off(tk, cx.ti), tk_len(tk, cx.ti), "c") {
            perr(cx, "'extern' declares C functions only: write 'extern c'",
                 line)
            return -1
        }
        cx.ti += 1
        # `extern c pure def sqrt(...)` is the useful spelling for a C function
        # with no side effects (math.h, mostly): `pure` is what lets it be called
        # from inside a `parallel for`, and a foreign function is exactly the one
        # whose purity the compiler cannot see for itself.
        mut xflag: int = 8
        if at_kw(tk, cx, 20) {
            xflag = 12
            cx.ti += 1
        }
        if not at_kw(tk, cx, 1) {
            perr(cx, "expected a function definition after 'extern c'", line)
            return -1
        }
        return parse_funcdef(src, tk, tkf, nd, ty, flt, cx, xflag)
    }
    if at_kw(tk, cx, 21) {
        return parse_structdef(src, tk, tkf, nd, ty, flt, cx)
    }
    if at_kw(tk, cx, 3) {
        return parse_if(src, tk, tkf, nd, ty, flt, cx)
    }
    if at_kw(tk, cx, 4) {
        perr(cx, "'elif' is not part of Vela; write 'else if'", line)
        return -1
    }
    if at_kw(tk, cx, 6) {
        return parse_while(src, tk, tkf, nd, ty, flt, cx)
    }
    if at_kw(tk, cx, 7) {
        return parse_for(src, tk, tkf, nd, ty, flt, cx, 0)
    }
    if at_kw(tk, cx, 22) {
        cx.ti += 1
        if not at_kw(tk, cx, 7) {
            perr(cx, "'parallel' must be followed by 'for'", line)
            return -1
        }
        return parse_for(src, tk, tkf, nd, ty, flt, cx, 1)
    }
    if at_kw(tk, cx, 24) {
        return parse_enumdef(src, tk, tkf, nd, ty, flt, cx)
    }
    if at_kw(tk, cx, 25) {
        return parse_match(src, tk, tkf, nd, ty, flt, cx)
    }
    if at_kw(tk, cx, 27) {
        return parse_defer(src, tk, tkf, nd, ty, flt, cx, line, 0)
    }
    if at_kw(tk, cx, 28) {
        return parse_defer(src, tk, tkf, nd, ty, flt, cx, line, 1)
    }
    if at_kw(tk, cx, 2) {
        if cx.indef == 1 {
            perr(cx, "a `defer` block may not `return`: the cleanups still pending would be skipped", line)
            return -1
        }
        cx.ti += 1
        n: int = new_node(nd, cx, 9, line)
        nd[n * 10 + 1] = -1
        if at_nl(tk, cx) or at_eof(tk, cx) {
            return n
        }
        v: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
        nd[n * 10 + 1] = v
        return n
    }
    if at_kw(tk, cx, 10) {
        if cx.indef == 1 {
            perr(cx, "a `defer` block may not `break`: it is not inside the loop it looks like it is in", line)
            return -1
        }
        if cx.aux == 0 {
            perr(cx, "'break' outside a loop", line)
            return -1
        }
        cx.ti += 1
        return new_node(nd, cx, 13, line)
    }
    if at_kw(tk, cx, 11) {
        if cx.indef == 1 {
            perr(cx, "a `defer` block may not `continue`: it is not inside the loop it looks like it is in", line)
            return -1
        }
        if cx.aux == 0 {
            perr(cx, "'continue' outside a loop", line)
            return -1
        }
        cx.ti += 1
        return new_node(nd, cx, 14, line)
    }
    if at_kw(tk, cx, 12) {
        cx.ti += 1
        return new_node(nd, cx, 15, line)
    }
    return parse_simple(src, tk, tkf, nd, ty, flt, cx)
}

# `flag` is what goes into the node's flag word: 4 for `pure def`, 0 otherwise
def parse_funcdef(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                  mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                  mut flt: Array[float, 262144], mut cx: Ctx, flag: int) -> int {
    line: int = ti_line(tk, cx)
    cx.ti += 1
    if not at_name(tk, cx) {
        if kw_as_name(tk, cx, line) {
            return -1
        }
        perr(cx, "expected a function name", line)
        return -1
    }
    nm: int = name_id(src, tk, cx)
    cx.ti += 1
    if not at_op(tk, cx, 9) {
        perr(cx, "expected '(' after the function name", ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    mut phead: int = -1
    mut ptail: int = -1
    mut pcount: int = 0
    if not at_op(tk, cx, 10) {
        while cx.err == 0 {
            mut pflag: int = 0
            if at_kw(tk, cx, 19) {
                pflag = 1
                cx.ti += 1
            }
            if not at_name(tk, cx) {
                if kw_as_name(tk, cx, ti_line(tk, cx)) {
                    return -1
                }
                perr(cx, "expected a parameter name", ti_line(tk, cx))
                return -1
            }
            pline: int = ti_line(tk, cx)
            pnm: int = name_id(src, tk, cx)
            cx.ti += 1
            if not at_op(tk, cx, 12) {
                perr(cx, concat(concat(concat("parameter '", interned(pnm)), "'"),
                                " has no type annotation"), pline)
                return -1
            }
            cx.ti += 1
            pt: int = parse_type(src, tk, ty, cx)
            if cx.err != 0 {
                return -1
            }
            pn: int = new_node(nd, cx, 3, pline)
            nd[pn * 10 + 1] = pnm
            nd[pn * 10 + 2] = pt
            nd[pn * 10 + 6] = pflag
            if phead < 0 {
                phead = pn
            } else {
                nd[ptail * 10 + 7] = pn
            }
            ptail = pn
            pcount += 1
            if at_op(tk, cx, 11) {
                cx.ti += 1
                continue
            }
            break
        }
    }
    if not at_op(tk, cx, 10) {
        perr(cx, "expected ')' after the parameters", ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    if not at_op(tk, cx, 26) {
        perr(cx, concat(concat("function '", interned(nm)),
                        "' has no return type annotation"), ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    rt: int = parse_type(src, tk, ty, cx)
    if cx.err != 0 {
        return -1
    }
    # Flag 8 is `extern c`: a *declaration*, so there is no body to parse.  The
    # three `-1`s below are the whole of how a foreign function is marked — the
    # resolver copies word 8 into `FT_BODY`, the checker and the emitter ask
    # whether it is negative, and no flag has to be threaded through either.
    mut body: int = -1
    mut bcount: int = 0
    if (flag & 8) == 0 {
        mut savedfn: int = cx.fndef
        mut savedd: int = cx.dfirst
        mut savede: int = cx.efirst
        cx.fndef = 1
        cx.dfirst = -1
        cx.efirst = -1
        body = parse_body(src, tk, tkf, nd, ty, flt, cx)
        bcount = cx.rslot
        cx.fndef = savedfn
        # `defer`: the records were collected most-recent-first while the body was
        # parsed.  One chain per kind serves every exit, and the appended copy is what
        # makes the block part of the body for everybody who *walks* it -- resolve
        # assigns its slots, the checker checks it, and a body that falls off the end
        # runs it.
        #
        # The `errdefer` group goes in as ONE marker statement (kind 43) rather than as
        # bare statements: the marker is what the checker reads to refuse `errdefer` in
        # a function whose result is not an enum with an `Err` variant, and the block
        # itself is run by the back ends through `ret + 9`.  The marker sits after the
        # body's last `return`, which is dead code -- and `errdefer` in a function that
        # can fall off the end is refused by the checker, so there is no live path that
        # would reach it.
        if cx.dfirst > 0 or cx.efirst > 0 {
            mut dchain: int = -1
            mut echain: int = -1
            mut mcount: int = 0
            if cx.dfirst > 0 {
                dchain = defers_chain(nd, cx.dfirst)
                mcount += defers_count(nd, cx.dfirst)
            }
            mut marker: int = -1
            if cx.efirst > 0 {
                echain = defers_chain(nd, cx.efirst)
                # the marker carries the *errdefer's* line, not the `def`'s: it is the
                # node the checker refuses, so `at file:N` names the line a reader fixes
                marker = new_node(nd, cx, 43, nd[cx.efirst * 10 + 5])
                nd[marker * 10 + 1] = echain
                nd[marker * 10 + 2] = defers_count(nd, cx.efirst)
                mcount += 1
            }
            defers_stamp(nd, body, dchain, echain)
            if body < 0 {
                body = dchain
            } else {
                mut t: int = body
                while nd_nx(nd, t) > 0 {
                    t = nd_nx(nd, t)
                }
                if dchain > 0 {
                    nd[t * 10 + 7] = dchain
                    mut t2: int = dchain
                    while nd_nx(nd, t2) > 0 {
                        t2 = nd_nx(nd, t2)
                    }
                    t = t2
                }
                if marker > 0 {
                    nd[t * 10 + 7] = marker
                }
            }
            bcount += mcount
        }
        cx.dfirst = savedd
        cx.efirst = savede
    }
    n: int = new_node(nd, cx, 2, line)
    nd[n * 10 + 1] = nm
    nd[n * 10 + 2] = rt
    nd[n * 10 + 3] = phead
    nd[n * 10 + 4] = pcount
    nd[n * 10 + 6] = flag
    nd[n * 10 + 8] = body
    nd[n * 10 + 9] = bcount
    return n
}

# A struct body is an ordinary block: its statements are either field
# declarations (`name: T`) or `def`s.  Telling them apart is the *dumper's* and
# the interpreter's job, so the parser stores the block as it stands and one
# shape of body covers both.
def parse_structdef(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                    mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                    mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    cx.ti += 1
    if not at_name(tk, cx) {
        perr(cx, "expected a struct name", line)
        return -1
    }
    nm: int = name_id(src, tk, cx)
    cx.ti += 1
    body: int = parse_body(src, tk, tkf, nd, ty, flt, cx)
    bcount: int = cx.rslot
    n: int = new_node(nd, cx, 4, line)
    nd[n * 10 + 1] = nm
    nd[n * 10 + 2] = body
    nd[n * 10 + 3] = bcount
    return n
}

# `enum Shape { Circle(radius: float) Rect(w: float, h: float) Empty }`
#
# One variant per statement, which is why this is a loop of its own instead of
# `parse_body`: a struct's body is ordinary statements (a field is a declaration
# and a method is a `def`), but an enum's body has exactly one statement shape,
# and letting `parse_stmt` see `Circle(radius: float)` would parse it as a *call*
# and then fail on the `:`.
#
# A payload field reuses the parameter node (kind 3: name and type), so the two
# places a "name: type" pair is parsed stay the same shape.
def parse_enumdef(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                  mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                  mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    cx.ti += 1
    if not at_name(tk, cx) {
        perr(cx, "expected an enum name", line)
        return -1
    }
    nm: int = name_id(src, tk, cx)
    cx.ti += 1
    if not at_op(tk, cx, 33) {
        perr(cx, concat(concat("expected '{' to open the enum body, found '",
                               tok_text(src, tk, cx)), "'"), ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    mut head: int = -1
    mut tail: int = -1
    mut count: int = 0
    while cx.err == 0 and not at_close(tk, cx) {
        if at_nl(tk, cx) {
            cx.ti += 1
            continue
        }
        v: int = parse_variant(src, tk, tkf, nd, ty, flt, cx)
        if v >= 0 {
            if head < 0 {
                head = v
            } else {
                nd[tail * 10 + 7] = v
            }
            tail = v
            count += 1
        }
        if cx.err != 0 {
            break
        }
        end_of_stmt(src, tk, cx)
    }
    if cx.err != 0 {
        return -1
    }
    if at_eof(tk, cx) {
        perr(cx, "missing '}': an enum body is never closed", ti_line(tk, cx))
        return -1
    }
    if count == 0 {
        perr(cx, "an enum needs at least one variant", line)
        return -1
    }
    cx.ti += 1
    n: int = new_node(nd, cx, 35, line)
    nd[n * 10 + 1] = nm
    nd[n * 10 + 2] = head
    nd[n * 10 + 3] = count
    return n
}

def parse_variant(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                  mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                  mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    if not at_name(tk, cx) {
        if kw_as_name(tk, cx, line) {
            return -1
        }
        perr(cx, concat(concat("expected a variant name, found '",
                               tok_text(src, tk, cx)), "'"), line)
        return -1
    }
    nm: int = name_id(src, tk, cx)
    cx.ti += 1
    mut head: int = -1
    mut tail: int = -1
    mut count: int = 0
    if at_op(tk, cx, 9) {
        cx.ti += 1
        if not at_op(tk, cx, 10) {
            while cx.err == 0 {
                fl: int = ti_line(tk, cx)
                if not at_name(tk, cx) {
                    perr(cx, concat(concat("expected a payload field name, found '",
                                           tok_text(src, tk, cx)), "'"), fl)
                    return -1
                }
                fn: int = name_id(src, tk, cx)
                cx.ti += 1
                if not at_op(tk, cx, 12) {
                    perr(cx, concat(concat(concat("payload field '", interned(fn)),
                                           "'"), " has no type annotation"), fl)
                    return -1
                }
                cx.ti += 1
                ft: int = parse_type(src, tk, ty, cx)
                if cx.err != 0 {
                    return -1
                }
                fnd: int = new_node(nd, cx, 3, fl)
                nd[fnd * 10 + 1] = fn
                nd[fnd * 10 + 2] = ft
                if head < 0 {
                    head = fnd
                } else {
                    nd[tail * 10 + 7] = fnd
                }
                tail = fnd
                count += 1
                if at_op(tk, cx, 11) {
                    cx.ti += 1
                    continue
                }
                break
            }
        }
        if not at_op(tk, cx, 10) {
            perr(cx, "expected ')' to close the payload", ti_line(tk, cx))
            return -1
        }
        cx.ti += 1
    }
    n: int = new_node(nd, cx, 36, line)
    nd[n * 10 + 1] = nm
    nd[n * 10 + 2] = head
    nd[n * 10 + 3] = count
    return n
}

def parse_if(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
             mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
             mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    cx.ti += 1
    cond: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
    then_head: int = parse_body(src, tk, tkf, nd, ty, flt, cx)
    then_count: int = cx.rslot
    if cx.err == 0 and at_kw(tk, cx, 4) {
        perr(cx, "'elif' is not part of Vela; write 'else if'", ti_line(tk, cx))
        return -1
    }
    mut else_head: int = -1
    mut else_count: int = 0
    if cx.err == 0 and at_kw(tk, cx, 5) {
        cx.ti += 1
        if at_kw(tk, cx, 3) {
            else_head = parse_if(src, tk, tkf, nd, ty, flt, cx)
            else_count = 1
        } else {
            else_head = parse_body(src, tk, tkf, nd, ty, flt, cx)
            else_count = cx.rslot
        }
    }
    n: int = new_node(nd, cx, 10, line)
    nd[n * 10 + 1] = cond
    nd[n * 10 + 2] = then_head
    nd[n * 10 + 3] = then_count
    nd[n * 10 + 4] = else_head
    nd[n * 10 + 8] = else_count
    return n
}

def parse_while(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    cx.ti += 1
    cond: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
    cx.aux += 1
    body: int = parse_body(src, tk, tkf, nd, ty, flt, cx)
    bcount: int = cx.rslot
    cx.aux -= 1
    n: int = new_node(nd, cx, 11, line)
    nd[n * 10 + 1] = cond
    nd[n * 10 + 2] = body
    nd[n * 10 + 3] = bcount
    return n
}

def parse_for(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
              mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
              mut flt: Array[float, 262144], mut cx: Ctx, par: int) -> int {
    line: int = ti_line(tk, cx)
    cx.ti += 1
    if not at_name(tk, cx) {
        perr(cx, "expected a loop variable", line)
        return -1
    }
    var: int = name_id(src, tk, cx)
    cx.ti += 1
    if not at_kw(tk, cx, 8) {
        perr(cx, "expected 'in' after the loop variable", ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    if not at_kw(tk, cx, 9) {
        perr(cx, "this front end iterates range(...) only", ti_line(tk, cx))
        return -1
    }
    if not at_op2(tk, cx, 1, 9) {
        perr(cx, "'range' is a function: write range(0, n)", ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    cx.ti += 1
    mut start: int = -1
    mut stop: int = -1
    mut step: int = -1
    mut nargs: int = 0
    if not at_op(tk, cx, 10) {
        while cx.err == 0 {
            a: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
            if nargs == 0 {
                start = a
            } else if nargs == 1 {
                stop = a
            } else if nargs == 2 {
                step = a
            }
            nargs += 1
            if at_op(tk, cx, 11) {
                cx.ti += 1
                continue
            }
            break
        }
    }
    if not at_op(tk, cx, 10) {
        perr(cx, "expected ')' to close range(...)", ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    if nargs < 1 or nargs > 3 {
        perr(cx, "range() takes 1 to 3 arguments", line)
        return -1
    }
    if nargs == 1 {
        # `range(n)` is sugar for `range(0, n)`, and the single argument landed in
        # `start` (the first one parsed), NOT in `stop`.  This line read `stop` until
        # it was measured: with one argument `stop` was still -1, so the loop node
        # carried `stop = -1` and every walker that followed it -- the dumper, the C
        # back end, the LLVM back end and the interpreter -- dereferenced node -1 and
        # died with 0xC000000D.  `check` accepted the program, so nothing caught it,
        # and no corpus file used a one-argument `range`, which is why it survived.
        kept: int = start
        zero: int = new_node(nd, cx, 20, line)
        nd[zero * 10 + 1] = 0
        start = zero
        stop = kept
    }
    cx.aux += 1
    body: int = parse_body(src, tk, tkf, nd, ty, flt, cx)
    bcount: int = cx.rslot
    cx.aux -= 1
    n: int = new_node(nd, cx, 12, line)
    nd[n * 10 + 1] = var
    nd[n * 10 + 2] = start
    nd[n * 10 + 3] = stop
    nd[n * 10 + 4] = step
    nd[n * 10 + 6] = par
    nd[n * 10 + 8] = body
    nd[n * 10 + 9] = bcount
    return n
}

# `match s { Circle(r) { ... } else { ... } }`
#
# A statement, not an expression (ENUMS_PLAN.md's decision, and the same rule the
# rest of Vela already keeps: a value-producing expression cannot be a statement,
# so an expression-producing `match` would be the one exception).  `else` is the
# exhaustiveness escape hatch and takes no binding; which arm is legal where -- a
# duplicate arm, an arm after `else`, a missing variant -- is the checker's
# question, not the parser's, because the answer needs the enum's variant list.
def parse_match(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    cx.ti += 1
    subj: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
    if cx.err != 0 {
        return -1
    }
    if not at_op(tk, cx, 33) {
        perr(cx, concat(concat("expected '{' to open the match body, found '",
                               tok_text(src, tk, cx)), "'"), ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    mut head: int = -1
    mut tail: int = -1
    mut count: int = 0
    while cx.err == 0 and not at_close(tk, cx) {
        if at_nl(tk, cx) {
            cx.ti += 1
            continue
        }
        a: int = parse_arm(src, tk, tkf, nd, ty, flt, cx)
        if a >= 0 {
            if head < 0 {
                head = a
            } else {
                nd[tail * 10 + 7] = a
            }
            tail = a
            count += 1
        }
        if cx.err != 0 {
            break
        }
        end_of_stmt(src, tk, cx)
    }
    if cx.err != 0 {
        return -1
    }
    if at_eof(tk, cx) {
        perr(cx, "missing '}': a match body is never closed", ti_line(tk, cx))
        return -1
    }
    cx.ti += 1
    if count == 0 {
        perr(cx, "a match needs at least one arm", line)
        return -1
    }
    n: int = new_node(nd, cx, 37, line)
    nd[n * 10 + 1] = subj
    nd[n * 10 + 2] = head
    nd[n * 10 + 3] = count
    return n
}

# `Circle(r) { ... }`, `Empty { ... }` or `else { ... }`.
#
# v1 binds positionally, so a pattern is a variant name and a parenthesised list
# of plain names — no nested patterns and no guards.  A nested pattern is caught
# here rather than left to the checker because it is a *shape*: `Wrap(Small(n))`
# has a call where a binding belongs, and the closing-token check below refuses it
# with a message that names what it saw.  The binding's *arity* is deliberately
# not judged here — that needs the variant's field count, which is the checker's.
def parse_arm(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
              mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
              mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    mut pat: int = -1
    mut bhead: int = -1
    mut btail: int = -1
    mut bcount: int = 0
    if at_kw(tk, cx, 5) {
        cx.ti += 1
    } else if at_name(tk, cx) {
        pat = name_id(src, tk, cx)
        cx.ti += 1
        if at_op(tk, cx, 9) {
            cx.ti += 1
            if not at_op(tk, cx, 10) {
                while cx.err == 0 {
                    bl: int = ti_line(tk, cx)
                    if not at_name(tk, cx) {
                        perr(cx, concat(concat("expected a binding name, found '",
                                               tok_text(src, tk, cx)), "'"), bl)
                        return -1
                    }
                    bn: int = name_id(src, tk, cx)
                    cx.ti += 1
                    bnd: int = new_node(nd, cx, 25, bl)
                    nd[bnd * 10 + 1] = bn
                    if bhead < 0 {
                        bhead = bnd
                    } else {
                        nd[btail * 10 + 7] = bnd
                    }
                    btail = bnd
                    bcount += 1
                    if at_op(tk, cx, 11) {
                        cx.ti += 1
                        continue
                    }
                    break
                }
            }
            if not at_op(tk, cx, 10) {
                perr(cx, concat(concat(
                    "nested patterns are not supported in Vela 0.1; a pattern binds plain names, and '",
                    tok_text(src, tk, cx)), "' is where one would start"), ti_line(tk, cx))
                return -1
            }
            cx.ti += 1
        }
    } else {
        perr(cx, concat(concat("expected a variant name or 'else' to open a match arm, found '",
                               tok_text(src, tk, cx)), "'"), line)
        return -1
    }
    body: int = parse_body(src, tk, tkf, nd, ty, flt, cx)
    bodyc: int = cx.rslot
    n: int = new_node(nd, cx, 38, line)
    nd[n * 10 + 1] = pat
    nd[n * 10 + 2] = bhead
    nd[n * 10 + 3] = bcount
    nd[n * 10 + 4] = body
    nd[n * 10 + 8] = bodyc
    return n
}

# `mut x: int = 0`, `x: int = 0`, `x = e`, `x += e`, `f(x)`
def parse_simple(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                 mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                 mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    if at_kw(tk, cx, 19) {
        cx.ti += 1
        if not at_name(tk, cx) {
            # `mut import: int = 1` is the program SPEC.md 1.3 named as legal in 0.1 and
            # promised a renaming.  This is that sentence: the refusal says which word
            # arrived and which document claimed it, rather than "expected a name".
            if kw_as_name(tk, cx, line) {
                return -1
            }
            perr(cx, "expected a variable name after 'mut'", line)
            return -1
        }
        nm: int = name_id(src, tk, cx)
        cx.ti += 1
        mut decl: int = -1
        if at_op(tk, cx, 12) {
            cx.ti += 1
            decl = parse_type(src, tk, ty, cx)
        }
        mut val: int = -1
        if at_op(tk, cx, 8) {
            cx.ti += 1
            val = parse_expr(src, tk, tkf, nd, ty, flt, cx)
        } else if decl < 0 {
            perr(cx, "a 'mut' binding needs an initialiser or a type", line)
            return -1
        }
        if cx.err != 0 {
            return -1
        }
        n: int = new_node(nd, cx, 6, line)
        tgt: int = new_node(nd, cx, 25, line)
        nd[tgt * 10 + 1] = nm
        nd[n * 10 + 1] = tgt
        nd[n * 10 + 2] = val
        nd[n * 10 + 3] = decl
        nd[n * 10 + 6] = 3
        return n
    }
    if at_name(tk, cx) and at_op2(tk, cx, 1, 12) {
        nm2: int = name_id(src, tk, cx)
        cx.ti += 1
        cx.ti += 1
        decl2: int = parse_type(src, tk, ty, cx)
        mut val2: int = -1
        if at_op(tk, cx, 8) {
            cx.ti += 1
            val2 = parse_expr(src, tk, tkf, nd, ty, flt, cx)
        }
        if cx.err != 0 {
            return -1
        }
        n2: int = new_node(nd, cx, 6, line)
        tgt2: int = new_node(nd, cx, 25, line)
        nd[tgt2 * 10 + 1] = nm2
        nd[n2 * 10 + 1] = tgt2
        nd[n2 * 10 + 2] = val2
        nd[n2 * 10 + 3] = decl2
        nd[n2 * 10 + 6] = 2
        return n2
    }
    lhs: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
    if cx.err != 0 {
        return -1
    }
    if at_op(tk, cx, 8) {
        cx.ti += 1
        val3: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
        n3: int = new_node(nd, cx, 6, line)
        nd[n3 * 10 + 1] = lhs
        nd[n3 * 10 + 2] = val3
        nd[n3 * 10 + 3] = -1
        return n3
    }
    if is_aug(tk, cx) {
        base: int = aug_base(ti_val(tk, cx))
        cx.ti += 1
        val4: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
        n4: int = new_node(nd, cx, 7, line)
        nd[n4 * 10 + 1] = lhs
        nd[n4 * 10 + 2] = val4
        nd[n4 * 10 + 3] = base
        return n4
    }
    n5: int = new_node(nd, cx, 8, line)
    nd[n5 * 10 + 1] = lhs
    return n5
}

# ---------------------------------------------------------------------------
# expressions, loosest binding outermost
#
# Every level is its own function so that the precedence is the call graph: to
# read the grammar you read these signatures in order.

def parse_expr(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
               mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
               mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    return parse_or(src, tk, tkf, nd, ty, flt, cx)
}

def parse_or(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
             mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
             mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_and(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and at_kw(tk, cx, 14) {
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_and(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 29, line)
        nd[n * 10 + 1] = 14
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_and(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
              mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
              mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_not(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and at_kw(tk, cx, 13) {
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_not(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 29, line)
        nd[n * 10 + 1] = 13
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_not(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
              mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
              mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    if cx.err != 0 {
        return -1
    }
    if at_kw(tk, cx, 15) {
        line: int = ti_line(tk, cx)
        cx.ti += 1
        operand: int = parse_not(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 28, line)
        nd[n * 10 + 1] = 15
        nd[n * 10 + 2] = operand
        return n
    }
    return parse_cmp(src, tk, tkf, nd, ty, flt, cx)
}

# one comparison, never a chain: `a < b < c` is refused where it is written
def parse_cmp(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
              mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
              mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    left: int = parse_bitor(src, tk, tkf, nd, ty, flt, cx)
    if cx.err != 0 {
        return -1
    }
    if is_cmp_op(tk, cx) {
        op: int = ti_val(tk, cx)
        line: int = ti_line(tk, cx)
        cx.ti += 1
        right: int = parse_bitor(src, tk, tkf, nd, ty, flt, cx)
        if is_cmp_op(tk, cx) {
            perr(cx, "chained comparison is not allowed", ti_line(tk, cx))
            return -1
        }
        n: int = new_node(nd, cx, 30, line)
        nd[n * 10 + 1] = op
        nd[n * 10 + 2] = left
        nd[n * 10 + 3] = right
        return n
    }
    return left
}

def parse_bitor(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_bitxor(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and at_op(tk, cx, 18) {
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_bitxor(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 27, line)
        nd[n * 10 + 1] = 18
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_bitxor(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                 mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                 mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_bitand(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and at_op(tk, cx, 19) {
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_bitand(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 27, line)
        nd[n * 10 + 1] = 19
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_bitand(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                 mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                 mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_shift(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and at_op(tk, cx, 17) {
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_shift(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 27, line)
        nd[n * 10 + 1] = 17
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_shift(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_additive(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and (at_op(tk, cx, 35) or at_op(tk, cx, 36)) {
        op: int = ti_val(tk, cx)
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_additive(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 27, line)
        nd[n * 10 + 1] = op
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_additive(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                   mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                   mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_multiplicative(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and (at_op(tk, cx, 1) or at_op(tk, cx, 2)) {
        op: int = ti_val(tk, cx)
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_multiplicative(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 27, line)
        nd[n * 10 + 1] = op
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_multiplicative(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                         mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                         mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_unary(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 and (at_op(tk, cx, 3) or at_op(tk, cx, 4) or at_op(tk, cx, 5) or at_op(tk, cx, 20)) {
        op: int = ti_val(tk, cx)
        line: int = ti_line(tk, cx)
        cx.ti += 1
        rhs: int = parse_unary(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 27, line)
        nd[n * 10 + 1] = op
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = rhs
        node = n
    }
    return node
}

def parse_unary(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    if cx.err != 0 {
        return -1
    }
    if at_op(tk, cx, 2) or at_op(tk, cx, 1) or at_op(tk, cx, 32) {
        op: int = ti_val(tk, cx)
        line: int = ti_line(tk, cx)
        cx.ti += 1
        operand: int = parse_unary(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 28, line)
        nd[n * 10 + 1] = op
        nd[n * 10 + 2] = operand
        return n
    }
    return parse_power(src, tk, tkf, nd, ty, flt, cx)
}

def parse_power(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    node: int = parse_postfix(src, tk, tkf, nd, ty, flt, cx)
    if cx.err != 0 {
        return -1
    }
    if at_op(tk, cx, 21) {
        line: int = ti_line(tk, cx)
        cx.ti += 1
        right: int = parse_unary(src, tk, tkf, nd, ty, flt, cx)
        n: int = new_node(nd, cx, 27, line)
        nd[n * 10 + 1] = 21
        nd[n * 10 + 2] = node
        nd[n * 10 + 3] = right
        return n
    }
    return node
}

def parse_postfix(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                  mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                  mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    mut node: int = parse_atom(src, tk, tkf, nd, ty, flt, cx)
    while cx.err == 0 {
        if at_op(tk, cx, 9) {
            line: int = ti_line(tk, cx)
            cx.ti += 1
            mut ahead: int = -1
            mut atail: int = -1
            mut acount: int = 0
            if not at_op(tk, cx, 10) {
                while cx.err == 0 {
                    a: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
                    if a >= 0 {
                        if ahead < 0 {
                            ahead = a
                        } else {
                            nd[atail * 10 + 7] = a
                        }
                        atail = a
                        acount += 1
                    }
                    if at_op(tk, cx, 11) {
                        cx.ti += 1
                        continue
                    }
                    break
                }
            }
            if not at_op(tk, cx, 10) {
                perr(cx, "expected ')' to close the call", ti_line(tk, cx))
                return -1
            }
            cx.ti += 1
            c: int = new_node(nd, cx, 26, line)
            nd[c * 10 + 1] = node
            nd[c * 10 + 2] = ahead
            nd[c * 10 + 3] = acount
            node = c
            continue
        }
        if at_op(tk, cx, 14) {
            line2: int = ti_line(tk, cx)
            cx.ti += 1
            mut lower: int = -1
            if not at_op(tk, cx, 12) {
                lower = parse_expr(src, tk, tkf, nd, ty, flt, cx)
            }
            if at_op(tk, cx, 12) {
                cx.ti += 1
                mut upper: int = -1
                if not at_op(tk, cx, 15) {
                    upper = parse_expr(src, tk, tkf, nd, ty, flt, cx)
                }
                if not at_op(tk, cx, 15) {
                    perr(cx, "expected ']' to close the slice", ti_line(tk, cx))
                    return -1
                }
                cx.ti += 1
                s: int = new_node(nd, cx, 34, line2)
                nd[s * 10 + 1] = node
                nd[s * 10 + 2] = lower
                nd[s * 10 + 3] = upper
                node = s
                continue
            }
            if not at_op(tk, cx, 15) {
                perr(cx, "expected ']' to close the index", ti_line(tk, cx))
                return -1
            }
            cx.ti += 1
            ix: int = new_node(nd, cx, 31, line2)
            nd[ix * 10 + 1] = node
            nd[ix * 10 + 2] = lower
            node = ix
            continue
        }
        if at_op(tk, cx, 13) {
            line3: int = ti_line(tk, cx)
            cx.ti += 1
            if not at_name(tk, cx) {
                perr(cx, "expected a field name after '.'", ti_line(tk, cx))
                return -1
            }
            nm: int = name_id(src, tk, cx)
            cx.ti += 1
            at: int = new_node(nd, cx, 32, line3)
            nd[at * 10 + 1] = node
            nd[at * 10 + 2] = nm
            node = at
            continue
        }
        break
    }
    return node
}

# `f"a{x}b"`: the token sequence the lexer left (44 begin, then 4 literal chunks and
# 45 <expr> 46, then 47) becomes the tree a reader would have written by hand --
#
#     concat(concat(lit("a"), to_str(x)), lit("b"))
#
# with an empty chunk skipped and the whole thing reduced to a single literal when
# there is no `{...}` at all.  `+` on two `str`s is the same runtime call as
# `concat` (SPEC 1.5), so either spelling would have done; `concat` is written out
# because it is the one that says what it means, and because the checker already
# treats it as the one operation.
#
# The conversion is a *call to the `to_str` builtin*, so no new node kind, no new
# checker rule and no new back-end case exist for interpolation: the lowering is
# exactly what a user could have typed.
def fstr_join(mut nd: Array[int, 1310720], mut cx: Ctx, left: int, right: int,
              line: int) -> int {
    if left < 0 {
        return right
    }
    callee: int = new_node(nd, cx, 25, line)
    nd[callee * 10 + 1] = intern("concat")
    n: int = new_node(nd, cx, 26, line)
    nd[n * 10 + 1] = callee
    nd[n * 10 + 2] = left
    nd[n * 10 + 3] = 2
    # the argument chain of *this* call: `left` is its first argument, so `right`
    # hangs off `left`'s sibling slot.  That slot is free -- a call keeps its own
    # arguments in +2..+7 of the *first* argument, never in its own +7 -- which is
    # what makes a left-nested chain legal.
    nd[left * 10 + 7] = right
    return n
}

def fstr_to_str(mut nd: Array[int, 1310720], mut cx: Ctx, e: int,
                line: int) -> int {
    callee: int = new_node(nd, cx, 25, line)
    nd[callee * 10 + 1] = intern("to_str")
    n: int = new_node(nd, cx, 26, line)
    nd[n * 10 + 1] = callee
    nd[n * 10 + 2] = e
    nd[n * 10 + 3] = 1
    return n
}

def parse_fstring(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                  mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                  mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    line: int = ti_line(tk, cx)
    mut node: int = -1
    cx.ti += 1
    while cx.err == 0 {
        kk: int = ti_kind(tk, cx)
        if kk == 47 {
            cx.ti += 1
            break
        }
        if kk == 4 {
            off: int = tk_off(tk, cx.ti)
            ln: int = tk_len(tk, cx.ti)
            fl: int = tk_flag(tk, cx.ti)
            l2: int = ti_line(tk, cx)
            cx.ti += 1
            lit_n: int = new_node(nd, cx, 22, l2)
            nd[lit_n * 10 + 1] = off
            nd[lit_n * 10 + 2] = ln
            nd[lit_n * 10 + 6] = fl
            node = fstr_join(nd, cx, node, lit_n, l2)
            continue
        }
        if kk == 45 {
            ex_line: int = ti_line(tk, cx)
            cx.ti += 1
            e: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
            if cx.err != 0 {
                return -1
            }
            if ti_kind(tk, cx) != 46 {
                perr(cx, "expected '}' to close the interpolated expression",
                     ti_line(tk, cx))
                return -1
            }
            cx.ti += 1
            node = fstr_join(nd, cx, node, fstr_to_str(nd, cx, e, ex_line), ex_line)
            continue
        }
        perr(cx, "this is not part of an interpolated string", ti_line(tk, cx))
        return -1
    }
    if node < 0 {
        # `f""`: an empty literal, not the absence of a value.  Offset 0 with
        # length 0 is the empty string in every reader of kind 22.
        node = new_node(nd, cx, 22, line)
        nd[node * 10 + 1] = 0
        nd[node * 10 + 2] = 0
        nd[node * 10 + 6] = 0
    }
    return node
}

def parse_atom(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
               mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
               mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    if cx.err != 0 {
        return -1
    }
    line: int = ti_line(tk, cx)
    k: int = ti_kind(tk, cx)
    if k == 44 {
        return parse_fstring(src, tk, tkf, nd, ty, flt, cx)
    }
    if k == 2 {
        v: int = ti_val(tk, cx)
        cx.ti += 1
        n: int = new_node(nd, cx, 20, line)
        nd[n * 10 + 1] = v
        return n
    }
    if k == 3 {
        ti0: int = cx.ti
        f: float = tkf[ti0]
        cx.ti += 1
        idx: int = flt_add(flt, cx, f, line)
        n2: int = new_node(nd, cx, 21, line)
        nd[n2 * 10 + 1] = idx
        # The source span is kept as well as the value: the dump prints the
        # literal the way it was written, which is exact (and does not depend
        # on how a particular C library formats a double).
        nd[n2 * 10 + 2] = tk_off(tk, ti0)
        nd[n2 * 10 + 3] = tk_len(tk, ti0)
        # flag 2 travels from the token: the lexer marks a float literal that is
        # exactly zero, because the value itself lives in the float pool and the
        # checker is not given the pool
        if tk_flag(tk, ti0) == 2 {
            nd[n2 * 10 + 6] = 2
        }
        return n2
    }
    if k == 4 {
        off: int = tk_off(tk, cx.ti)
        ln: int = tk_len(tk, cx.ti)
        flag: int = tk_flag(tk, cx.ti)
        cx.ti += 1
        n3: int = new_node(nd, cx, 22, line)
        nd[n3 * 10 + 1] = off
        nd[n3 * 10 + 2] = ln
        nd[n3 * 10 + 6] = flag
        return n3
    }
    if at_name(tk, cx) {
        nm: int = name_id(src, tk, cx)
        cx.ti += 1
        n4: int = new_node(nd, cx, 25, line)
        nd[n4 * 10 + 1] = nm
        return n4
    }
    if at_kw(tk, cx, 16) {
        cx.ti += 1
        n5: int = new_node(nd, cx, 23, line)
        nd[n5 * 10 + 1] = 1
        return n5
    }
    if at_kw(tk, cx, 17) {
        cx.ti += 1
        n6: int = new_node(nd, cx, 23, line)
        nd[n6 * 10 + 1] = 0
        return n6
    }
    if at_kw(tk, cx, 18) {
        cx.ti += 1
        return new_node(nd, cx, 24, line)
    }
    if at_op(tk, cx, 9) {
        cx.ti += 1
        inner: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
        if at_op(tk, cx, 11) {
            perr(cx, "tuples are not supported", ti_line(tk, cx))
            return -1
        }
        if not at_op(tk, cx, 10) {
            perr(cx, "expected ')' to close the group", ti_line(tk, cx))
            return -1
        }
        cx.ti += 1
        return inner
    }
    if at_op(tk, cx, 14) {
        cx.ti += 1
        mut ahead: int = -1
        mut atail: int = -1
        mut acount: int = 0
        if not at_op(tk, cx, 15) {
            while cx.err == 0 {
                e: int = parse_expr(src, tk, tkf, nd, ty, flt, cx)
                if e >= 0 {
                    if ahead < 0 {
                        ahead = e
                    } else {
                        nd[atail * 10 + 7] = e
                    }
                    atail = e
                    acount += 1
                }
                if at_op(tk, cx, 11) {
                    cx.ti += 1
                    if at_op(tk, cx, 15) {
                        break
                    }
                    continue
                }
                break
            }
        }
        if not at_op(tk, cx, 15) {
            perr(cx, "expected ']' to close the array literal", ti_line(tk, cx))
            return -1
        }
        cx.ti += 1
        if acount == 0 {
            perr(cx, "an empty array literal has no element type", line)
            return -1
        }
        n7: int = new_node(nd, cx, 33, line)
        nd[n7 * 10 + 1] = ahead
        nd[n7 * 10 + 2] = acount
        return n7
    }
    perr(cx, "unexpected token in expression", line)
    return -1
}

# ---------------------------------------------------------------------------
# the whole file

def parse_module(src: str, tk: Array[int, 1572864], tkf: Array[float, 262144],
                 mut nd: Array[int, 1310720], mut ty: Array[int, 262144],
                 mut flt: Array[float, 262144], mut cx: Ctx) -> int {
    m: int = new_node(nd, cx, 1, 1)
    mut head: int = -1
    mut tail: int = -1
    mut count: int = 0
    while cx.err == 0 and not at_eof(tk, cx) {
        if at_nl(tk, cx) {
            cx.ti += 1
            continue
        }
        if at_op(tk, cx, 34) {
            perr(cx, "unexpected '}': there is no block open here",
                 ti_line(tk, cx))
            break
        }
        s: int = parse_stmt(src, tk, tkf, nd, ty, flt, cx, 1)
        if s >= 0 {
            if head < 0 {
                head = s
            } else {
                nd[tail * 10 + 7] = s
            }
            tail = s
            count += 1
        }
        if cx.err != 0 {
            break
        }
        end_of_stmt(src, tk, cx)
    }
    nd[m * 10 + 1] = head
    nd[m * 10 + 2] = count
    return m
}
