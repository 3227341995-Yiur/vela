# ---------------------------------------------------------------------------
# selfhost/parts/resolve.vel — binding and layout, before a single line runs.
#
# The tree the parser hands over is deliberately unlabelled: a name node holds
# an intern handle and nothing else, a declaration does not say which frame slot
# it will live in, a struct field has no index, and a method is a plain `def`
# with no owner — selfhost/AST.md §9 lists all of it.  This pass resolves; it does
# not judge.  `undeclared = 1` and `1 = 2` are refused here because a name cannot
# be bound, not because a rule was checked: the verdicts proper are
# `selfhost/parts/check.vel`, which runs after this one and judges what it
# resolved.
#
# This pass supplies what is missing, once, into the node and symbol tables:
#
#   * every `def` becomes a function record (owner, params, body), every
#     `struct` a struct record (fields in declaration order, methods, size);
#   * every declaration and every `for` variable gets a frame slot, so the
#     evaluator never searches a name at run time;
#   * every name node is bound to a local slot, a function, a struct or a
#     builtin — or the program is refused, with the line it was refused on;
#   * every declaration records the pool its elements live in, so the evaluator
#     does not have to re-derive types from the type pool on every execution.
#
# After this returns, `nd` and `ty` are still exactly as the parser left them and
# everything this pass learned is in `mem`.  Nothing here evaluates anything: a
# resolver that runs code is a resolver that cannot be trusted to have looked at
# the whole program first.
# ---------------------------------------------------------------------------

# `vela: <kind>: <message>`, then the location, exactly as the checker spells it:
# the resolver raises type errors as often as it raises anything else, and a
# reader — or a tool that has to tell a syntax error from a safety error — has to
# be able to tell them apart.  `tests/diff_check.py` used to be that reader; it
# was deleted with stage 0, and the recorded goldens are the reader now.
def fail_kind(path: str, line: int, kind: str, msg: str) -> None {
    warn_str("vela: ")
    warn_str(kind)
    warn_str(": ")
    warn_str(msg)
    warn_str("\n  at ")
    warn_str(path)
    warn_str(":")
    warn_int(line)
    warn_nl()
    panic("the interpreted program was refused")
}

def fail(path: str, line: int, msg: str) -> None {
    fail_kind(path, line, "type error", msg)
}

def fail_name(path: str, line: int, msg: str, name: str) -> None {
    fail_kind(path, line, "type error",
              concat(concat(msg, " '"), concat(name, "'")))
}

# --------------------------------------------------------------- scope stack
#
# One flat stack of (name, kind, value) entries in the tail of the stack cells:
# globals at the bottom, then a function's parameters, then the locals of every
# block currently open.  Lookup walks backwards, so the innermost declaration
# wins, which is exactly Vela's shadowing rule.

def sc_push(mut mem: Array[int, 3741696], mut vm: VM, name: int, kind: int,
            val: int, ckind: int, shape: int) -> None {
    if vm.scn >= SCOPE_MAX() {
        panic("vela: compiler: the resolver ran out of scope entries")
    }
    mem[SCOPE_BASE() + vm.scn * 4 + 0] = name
    mem[SCOPE_BASE() + vm.scn * 4 + 1] = kind
    mem[SCOPE_BASE() + vm.scn * 4 + 2] = val
    # the value kind travels with the binding: the back end has to spell a name
    # in C, and this is where it learns whether it is an int, a double or a
    # pointer into the arena
    mem[SCOPE_BASE() + vm.scn * 4 + 3] = ckind
    # and so does the *shape*: which struct-table row describes the value (or, for
    # an array, its elements).  It is a parameter of the push rather than a call a
    # caller may forget, because a binding whose row is stale would hand a `match`
    # the wrong variant list -- a wrong answer, which is the one outcome this
    # project refuses.  `-1` is the honest answer for a scalar and for a function.
    mem[SCOPE_SHAPE() + vm.scn] = shape
    vm.scn += 1
}

def sc_shape(mem: Array[int, 3741696], i: int) -> int {
    return mem[SCOPE_SHAPE() + i]
}

def sc_ckind(mem: Array[int, 3741696], i: int) -> int {
    return mem[SCOPE_BASE() + i * 4 + 3]
}

def sc_find(mut mem: Array[int, 3741696], vm: VM, name: int) -> int {
    mut i: int = vm.scn - 1
    while i >= 0 {
        if mem[SCOPE_BASE() + i * 4 + 0] == name {
            return i
        }
        i -= 1
    }
    return -1
}

def sc_kind(mut mem: Array[int, 3741696], i: int) -> int {
    return mem[SCOPE_BASE() + i * 4 + 1]
}

def sc_val(mut mem: Array[int, 3741696], i: int) -> int {
    return mem[SCOPE_BASE() + i * 4 + 2]
}

# ------------------------------------------------------------------ builtins
#
# A bare name that is neither local, function nor struct is a builtin or an
# error.  Comparing interned text is safe and cheap here because this runs once
# per name node, not once per execution.

def builtin_id(h: int) -> int {
    s: str = interned(h)
    if s == "print" { return B_PRINT() }
    if s == "emit_str" { return B_EMIT_STR() }
    if s == "emit_int" { return B_EMIT_INT() }
    if s == "emit_float" { return B_EMIT_FLT() }
    if s == "emit_nl" { return B_EMIT_NL() }
    if s == "warn_str" { return B_WARN_STR() }
    if s == "warn_int" { return B_WARN_INT() }
    if s == "warn_nl" { return B_WARN_NL() }
    if s == "len" { return B_LEN() }
    if s == "to_float" { return B_TO_FLOAT() }
    if s == "to_int" { return B_TO_INT() }
    if s == "sqrt" { return B_SQRT() }
    if s == "fabs" { return B_FABS() }
    if s == "floor" { return B_FLOOR() }
    if s == "pow" { return B_POW() }
    if s == "abs" { return B_ABS() }
    if s == "min_int" { return B_MIN_INT() }
    if s == "max_int" { return B_MAX_INT() }
    if s == "min_float" { return B_MIN_FLT() }
    if s == "max_float" { return B_MAX_FLT() }
    if s == "bytes_at" { return B_BYTES_AT() }
    if s == "substr" { return B_SUBSTR() }
    if s == "unescape" { return B_UNESCAPE() }
    if s == "intern" { return B_INTERN() }
    if s == "interned" { return B_INTERNED() }
    if s == "argc" { return B_ARGC() }
    if s == "arg" { return B_ARG() }
    if s == "read_text" { return B_READ_TEXT() }
    if s == "write_text" { return B_WRITE_TEXT() }
    if s == "panic" { return B_PANIC() }
    if s == "now" { return B_NOW() }
    if s == "concat" { return B_CONCAT() }
    if s == "run_command" { return B_RUN_CMD() }
    if s == "env" { return B_ENV() }
    return 0
}

# Arity of a builtin, or -1 when it is variadic (print and friends take any
# number of values).  Enforced at resolve time so a wrong arity is a refusal
# with a line number, not a strange failure in the middle of a run.

def builtin_arity(b: int) -> int {
    if b == B_PRINT() { return -1 }
    if b == B_EMIT_NL() { return 0 }
    if b == B_WARN_NL() { return 0 }
    if b == B_POW() { return 2 }
    if b == B_MIN_INT() { return 2 }
    if b == B_MAX_INT() { return 2 }
    if b == B_MIN_FLT() { return 2 }
    if b == B_MAX_FLT() { return 2 }
    if b == B_BYTES_AT() { return 2 }
    if b == B_SUBSTR() { return 3 }
    if b == B_WRITE_TEXT() { return 2 }
    if b == B_CONCAT() { return 2 }
    if b == B_ARGC() { return 0 }
    if b == B_NOW() { return 0 }
    return 1
}

# ------------------------------------------------------------- struct lookup

def find_struct(mem: Array[int, 3741696], vm: VM, name: int) -> int {
    mut i: int = 0
    while i < vm.nstruct {
        if stb_get(mem, i, STB_NAME()) == name {
            return i
        }
        i += 1
    }
    return -1
}

# --------------------------------------------------------------- enum lookup
#
# `find_enum` is the nominal name lookup, `find_variant` the one a bare variant
# name goes through, and `enum_of_type` the one a declared type goes through --
# the same three shapes `find_struct`/`struct_of_type` already have, because an
# enum is registered as a type *and* as a layout (see `add_enum_names`).

def find_enum(mem: Array[int, 3741696], vm: VM, name: int) -> int {
    mut i: int = 0
    while i < vm.nenum {
        if enb_get(mem, i, ENB_NAME()) == name {
            return i
        }
        i += 1
    }
    return -1
}

def find_variant(mem: Array[int, 3741696], vm: VM, name: int) -> int {
    mut i: int = 0
    while i < vm.nvr {
        if vrb_get(mem, i, VRB_NAME()) == name {
            return i
        }
        i += 1
    }
    return -1
}

# The enum whose layout row this is, or -1: the inverse of `ENB_SID`, and the only
# way a runtime value's struct-table row becomes a variant list.
def enum_of_row(mem: Array[int, 3741696], vm: VM, row: int) -> int {
    if row < 0 {
        return -1
    }
    mut i: int = 0
    while i < vm.nenum {
        if enb_get(mem, i, ENB_SID()) == row {
            return i
        }
        i += 1
    }
    return -1
}

def enum_of_type(ty: Array[int, 262144], t: int,
                 mem: Array[int, 3741696], vm: VM) -> int {
    if t < 0 {
        return -1
    }
    if ty_elem(ty, t) >= 0 {
        # an array of enums is an enum for the purposes of what it *is*: the
        # subject of `match a[i]` is an enum value, not an array
        return enum_of_type(ty, ty_elem(ty, t), mem, vm)
    }
    return find_enum(mem, vm, ty_base(ty, t))
}

# The struct-table row that describes a value of this type -- for an enum, the
# row its values actually use; for an array, the row of its elements (an array of
# enums is an array of *that* enum's values).  This is what rides in the scope
# stack's shape word and in `NT_ROW()` on a name node.
def shape_of_type(ty: Array[int, 262144], t: int,
                  mem: Array[int, 3741696], vm: VM) -> int {
    if t < 0 {
        return -1
    }
    if ty_elem(ty, t) >= 0 {
        return shape_of_type(ty, ty_elem(ty, t), mem, vm)
    }
    e: int = find_enum(mem, vm, ty_base(ty, t))
    if e >= 0 {
        return enb_get(mem, e, ENB_SID())
    }
    return find_struct(mem, vm, ty_base(ty, t))
}

# The kind of a declared type, as one of the K_* codes.  Only declarations need
# this: an expression's type is the value's tag at run time, which is why this
# interpreter has no type inference pass at all.
#
# A nested array (`Array[Array[int, 4], 8]`) has no representation here and is
# refused rather than silently stored as something else.

def type_kind(ty: Array[int, 262144], t: int, mem: Array[int, 3741696],
              vm: VM) -> int {
    if t < 0 {
        return K_NONE()
    }
    e: int = ty_elem(ty, t)
    if e >= 0 {
        ek: int = type_kind(ty, e, mem, vm)
        if ek == K_AI() {
            return K_BAD()
        }
        if ek == K_AF() {
            return K_BAD()
        }
        if ek == K_AB() {
            return K_BAD()
        }
        if ek == K_AA() {
            return K_BAD()
        }
        if ek == K_AS() {
            return K_BAD()
        }
        if ek == K_AX() {
            return K_BAD()
        }
        if ek == K_A32() {
            return K_BAD()
        }
        return arr_kind_of(ek)
    }
    base: int = ty_base(ty, t)
    s: str = interned(base)
    if s == "int" { return K_INT() }
    if s == "float" { return K_FLT() }
    if s == "bool" { return K_BOOL() }
    if s == "str" { return K_STR() }
    if s == "u8" { return K_U8() }
    if s == "i32" { return K_I32() }
    if s == "None" { return K_NONE() }
    # the enum lookup is a separate table from the struct one and is asked
    # *first*, on purpose: an enum registers a layout row of its own (under its
    # own name) so that so many other things keep working, and `find_struct`
    # would find it and answer `K_ST()` -- a struct -- for a type that is not one.
    if find_enum(mem, vm, base) >= 0 {
        return K_ENUM()
    }
    if find_struct(mem, vm, base) >= 0 {
        return K_ST()
    }
    return K_BAD()
}

def struct_of_type(ty: Array[int, 262144], t: int,
                   mem: Array[int, 3741696], vm: VM) -> int {
    if t < 0 {
        return -1
    }
    return find_struct(mem, vm, ty_base(ty, t))
}

# `type_kind` answers the bare kind, which is what a comparison wants.  A binding
# needs one word more: which struct it is, or how long its array is.  Both facts
# ride in the same word (pack_kind), and until this existed a struct binding
# claimed struct 0 -- right for a program with one struct, wrong for the compiler
# itself, which has a dozen.
#
# An enum binding needs the same word for a third reason: the row its *values*
# use, so that `Array[E, 4]` has a stride (`STB_SIZE`) and `copy_value` has a
# count.  It is the enum's layout row, the same number a struct binding carries,
# which is why `K_ENUM` and `K_ST` differ in the kind byte and agree in the rest.
def type_packed(ty: Array[int, 262144], t: int,
                mem: Array[int, 3741696], vm: VM) -> int {
    k: int = type_kind(ty, t, mem, vm)
    if k == K_ST() {
        return pack_kind(K_ST(), struct_of_type(ty, t, mem, vm))
    }
    if k == K_ENUM() {
        return pack_kind(K_ENUM(), shape_of_type(ty, t, mem, vm))
    }
    return pack_kind(k, ty_len(ty, t))
}

# ---------------------------------------------------------- registering shapes

def add_field(nd: Array[int, 655360], ty: Array[int, 262144],
              mut mem: Array[int, 3741696], path: str,
              mut vm: VM, sid: int, f: int) -> None {
    mut h: int = 0
    if nd_kind(nd, f) == 5 {
        h = nd[f * 10 + 1]
    } else {
        tgt: int = nd[f * 10 + 1]
        if nd_kind(nd, tgt) != 25 {
            fail(path, nd_line(nd, f), "a field needs a name")
        }
        h = nd[tgt * 10 + 1]
    }
    # a field record is two words: the name, and the packed kind of its type,
    # which the back end needs to spell the member in C
    ft: int = nd[f * 10 + 3]
    sfl_put(mem, vm.sfln, h)
    sfl_put(mem, vm.sfln + 1, type_packed(ty, ft, mem, vm))
    vm.sfln += 2
    n: int = stb_get(mem, sid, STB_NFIELD())
    stb_put(mem, sid, STB_NFIELD(), n + 1)
    # every field is one cell, so the size of an instance is its field count
    stb_put(mem, sid, STB_SIZE(), n + 1)
}

def add_function(nd: Array[int, 655360], mut mem: Array[int, 3741696], path: str,
                 mut vm: VM, d: int, owner: int) -> int {
    if vm.nfn >= 4096 {
        fail(path, nd_line(nd, d), "too many functions")
    }
    fn: int = vm.nfn
    vm.nfn += 1
    ft_put(mem, fn, FT_DEF(), d)
    ft_put(mem, fn, FT_OWNER(), owner)
    ft_put(mem, fn, FT_NPARAM(), nd[d * 10 + 4])
    ft_put(mem, fn, FT_RETTY(), nd[d * 10 + 2])
    ft_put(mem, fn, FT_PARAM(), nd[d * 10 + 3])
    ft_put(mem, fn, FT_BODY(), nd[d * 10 + 8])
    ft_put(mem, fn, FT_NLOCAL(), 0)
    if (nd[d * 10 + 6] & 4) == 4 {
        ft_put(mem, fn, FT_PURE(), 1)
    }
    if owner < 0 {
        sc_push(mem, vm, nd[d * 10 + 1], SYM_FUNC(), fn, 0, -1)
    }
    return fn
}

def add_struct(nd: Array[int, 655360], ty: Array[int, 262144],
               mut mem: Array[int, 3741696], path: str, mut vm: VM,
               s: int) -> None {
    if vm.nstruct >= 1024 {
        fail(path, nd_line(nd, s), "too many structs")
    }
    sid: int = vm.nstruct
    vm.nstruct += 1
    stb_put(mem, sid, STB_NAME(), nd[s * 10 + 1])
    stb_put(mem, sid, STB_NFIELD(), 0)
    stb_put(mem, sid, STB_FOFF(), vm.sfln)
    stb_put(mem, sid, STB_NMETH(), 0)
    stb_put(mem, sid, STB_MOFF(), vm.metn)
    stb_put(mem, sid, STB_SIZE(), 0)
    sc_push(mem, vm, nd[s * 10 + 1], SYM_STRUCT(), sid, 0, sid)

    mut m: int = nd[s * 10 + 2]
    while m > 0 {
        k: int = nd_kind(nd, m)
        if k == 6 {
            if (nd[m * 10 + 6] & 2) != 2 {
                fail(path, nd_line(nd, m),
                     "a struct body may hold field declarations and methods only")
            }
            add_field(nd, ty, mem, path, vm, sid, m)
        } else if k == 5 {
            add_field(nd, ty, mem, path, vm, sid, m)
        } else if k == 2 {
            fn: int = add_function(nd, mem, path, vm, m, sid)
            n: int = stb_get(mem, sid, STB_NMETH())
            mi: int = stb_get(mem, sid, STB_MOFF()) + n
            met_put(mem, mi, MET_STRUCT(), sid)
            met_put(mem, mi, MET_NAME(), nd[m * 10 + 1])
            met_put(mem, mi, MET_FN(), fn)
            met_put(mem, mi, MET_MUTSELF(), 0)
            pn: int = nd[m * 10 + 3]
            if pn > 0 {
                if (nd[pn * 10 + 6] & 1) == 1 {
                    met_put(mem, mi, MET_MUTSELF(), 1)
                }
            }
            stb_put(mem, sid, STB_NMETH(), n + 1)
        } else {
            fail(path, nd_line(nd, m), "a struct body may hold fields and methods only")
        }
        m = nd_nx(nd, m)
    }
}

# -------------------------------------------------------- registering enums
#
# `enum Shape { Circle(radius: float) Rect(w: float, h: float) Empty }` is three
# registrations, and the split is the whole design:
#
#   1. a *layout row* in the struct table, under the enum's own name, whose size
#      is `1 + the widest payload`.  That single row is what makes `mut c: Shape`,
#      `Array[Shape, 4]`, `copy_value`, `elem_store` and the C back end's existing
#      aggregate paths work on an enum value with no new machinery: an enum value
#      is a struct value whose cell reads (K_ST, payload base, this row, stride).
#      The block itself is `[tag, payload...]` -- cell 0 is the tag, cells 1.. are
#      the payload of whichever variant the tag names -- so the tag needs no word
#      of its own, and the "field count" the struct copier reads is exactly the
#      number of cells to copy.
#   2. a *nominal* row in the enum table, because a type name must resolve to
#      `K_ENUM` (not to the layout row it shares a name with) and because a
#      variant list has to be reachable from a `match`.
#   3. one *variant* record per variant: name, tag, field count, and a run of
#      payload field records (name + packed kind) in the vfl region.
#
# Two passes, because a payload field may name an enum declared *below* the one
# holding it (`enum Outer { Wrap(inner: Inner) }` before `enum Inner`).  The first
# pass registers every name in the file, so the second pass resolves field types
# against a table that is already complete.  A stride needs no types at all --
# every payload field is one cell, whatever it holds -- which is why the layout
# row can be finished in the first pass.

def add_enum_names(nd: Array[int, 655360],
                   mut mem: Array[int, 3741696], path: str, mut vm: VM,
                   s: int) -> None {
    name: int = nd[s * 10 + 1]
    if vm.nenum >= 4096 {
        fail(path, nd_line(nd, s), "too many enums")
    }
    if find_enum(mem, vm, name) >= 0 {
        fail_name(path, nd_line(nd, s), "duplicate enum", interned(name))
    }
    if find_struct(mem, vm, name) >= 0 {
        fail_name(path, nd_line(nd, s),
                  "this name is already a struct", interned(name))
    }
    if builtin_id(name) > 0 {
        fail_name(path, nd_line(nd, s),
                  "this name is already a builtin", interned(name))
    }
    if vm.nstruct >= 1024 {
        fail(path, nd_line(nd, s), "too many structs and enums together")
    }
    mut widest: int = 0
    mut v: int = nd[s * 10 + 2]
    while v > 0 {
        if nd[v * 10 + 3] > widest {
            widest = nd[v * 10 + 3]
        }
        v = nd_nx(nd, v)
    }
    eid: int = vm.nenum
    vm.nenum += 1
    sid: int = vm.nstruct
    vm.nstruct += 1
    stb_put(mem, sid, STB_NAME(), name)
    # the enum's own row has no fields: a payload belongs to a *variant*, and
    # which variant a value holds is the tag inside the block, not a field list
    stb_put(mem, sid, STB_NFIELD(), 0)
    stb_put(mem, sid, STB_FOFF(), vm.sfln)
    stb_put(mem, sid, STB_NMETH(), 0)
    stb_put(mem, sid, STB_MOFF(), vm.metn)
    stb_put(mem, sid, STB_SIZE(), widest + 1)
    enb_put(mem, eid, ENB_NAME(), name)
    enb_put(mem, eid, ENB_NVAR(), nd[s * 10 + 3])
    enb_put(mem, eid, ENB_VOFF(), vm.nvr)
    enb_put(mem, eid, ENB_SID(), sid)
    enb_put(mem, eid, ENB_STRIDE(), widest + 1)
    enb_put(mem, eid, ENB_NMAX(), widest)
}

def add_enum_variants(nd: Array[int, 655360], ty: Array[int, 262144],
                      mut mem: Array[int, 3741696], path: str, mut vm: VM,
                      s: int) -> None {
    eid: int = find_enum(mem, vm, nd[s * 10 + 1])
    if eid < 0 {
        # add_enum_names already refused this, and a -1 here would write variant
        # records for an enum that is not in the table
        panic("vela: compiler: an enum went missing between its two passes")
    }
    mut tag: int = 0
    mut v: int = nd[s * 10 + 2]
    while v > 0 {
        add_variant(nd, ty, mem, path, vm, eid, v, tag)
        tag += 1
        v = nd_nx(nd, v)
    }
}

def add_variant(nd: Array[int, 655360], ty: Array[int, 262144],
                mut mem: Array[int, 3741696], path: str, mut vm: VM,
                eid: int, v: int, tag: int) -> None {
    name: int = nd[v * 10 + 1]
    if vm.nvr >= 4096 {
        fail(path, nd_line(nd, v), "too many variants")
    }
    # A variant name is how a value is *built*, and v1 resolves it by spelling
    # alone: there is no expected-type machinery to make `Empty` mean
    # `Shape.Empty` in one position and `Tree.Empty` in another.  So one spelling
    # has to mean one enum, and a second enum asking for the same name is refused
    # here, naming both of them, rather than leaving the second one unreachable.
    prev: int = find_variant(mem, vm, name)
    if prev >= 0 {
        fail_kind(path, nd_line(nd, v), "type error",
                  concat(concat(concat(concat("variant '", interned(name)),
                                       "' is already declared by enum '"),
                                interned(enb_get(mem, vrb_get(mem, prev, VRB_ENUM()),
                                                 ENB_NAME()))),
                         "': a variant name must be unique in a file"))
    }
    if builtin_id(name) > 0 {
        fail_name(path, nd_line(nd, v),
                  "a builtin already has this name", interned(name))
    }
    vi: int = vm.nvr
    vm.nvr += 1
    vrb_put(mem, vi, VRB_NAME(), name)
    vrb_put(mem, vi, VRB_ENUM(), eid)
    vrb_put(mem, vi, VRB_TAG(), tag)
    vrb_put(mem, vi, VRB_NFIELD(), nd[v * 10 + 3])
    vrb_put(mem, vi, VRB_FOFF(), vm.vfln)
    mut f: int = nd[v * 10 + 2]
    while f > 0 {
        if vm.vfln + 2 > 16384 {
            fail(path, nd_line(nd, f), "too many payload fields")
        }
        fh: int = nd[f * 10 + 1]
        ft: int = nd[f * 10 + 2]
        fk: int = type_kind(ty, ft, mem, vm)
        if fk == K_BAD() {
            fail_kind(path, nd_line(nd, f), "type error",
                      concat(concat(concat(concat("payload field '",
                                                  interned(fh)),
                                           "' has type '"),
                                    interned(ty_base(ty, ft))),
                             "', which is not a type"))
        }
        if enum_of_type(ty, ft, mem, vm) == eid {
            fail_kind(path, nd_line(nd, v), "type error",
                      concat(concat(concat(concat("enum '",
                                                  interned(enb_get(mem, eid,
                                                                   ENB_NAME()))),
                                           "' cannot carry itself in a payload: variant '"),
                                    interned(name)),
                             "' has a field of that same enum type, and a value type cannot contain itself"))
        }
        vfl_put(mem, vm.vfln, fh)
        vfl_put(mem, vm.vfln + 1, type_packed(ty, ft, mem, vm))
        vm.vfln += 2
        f = nd_nx(nd, f)
    }
}

# After the whole top level is registered: a variant whose spelling is also a
# global name would be *unreachable*, because `bind_name` finds a local, a
# function, a struct or a builtin before it finds a variant.  Order in the file
# decides which of the two got there first, and a variant that silently means
# something else is a wrong answer, so this is refused by name instead.
def check_variants_visible(mem: Array[int, 3741696], path: str, vm: VM) -> None {
    mut i: int = 0
    while i < vm.nvr {
        h: int = vrb_get(mem, i, VRB_NAME())
        if sc_find(mem, vm, h) >= 0 {
            fail_kind(path, 1, "type error",
                      concat(concat("the variant name '", interned(h)),
                             "' is also a function or a struct, which would make the variant unreachable"))
        }
        i += 1
    }
}

# -------------------------------------------------------- binding expressions

def count_chain(nd: Array[int, 655360], head: int) -> int {
    mut n: int = 0
    mut a: int = head
    while a > 0 {
        n += 1
        a = nd_nx(nd, a)
    }
    return n
}

def check_call(nd: Array[int, 655360], mut mem: Array[int, 3741696], path: str,
               vm: VM, e: int, callee: int) -> None {
    nargs: int = count_chain(nd, nd[e * 10 + 2])
    if nd_kind(nd, callee) != 25 {
        # `recv.method(...)`: which method it is depends on the receiver's value
        return
    }
    sk: int = nt_get(mem, callee, NT_SYM())
    sv: int = nt_get(mem, callee, NT_VAL())
    if sk == SYM_FUNC() {
        if ft_get(mem, sv, FT_NPARAM()) != nargs {
            fail(path, nd_line(nd, e), "wrong number of arguments")
        }
        return
    }
    if sk == SYM_STRUCT() {
        if stb_get(mem, sv, STB_NFIELD()) != nargs {
            fail(path, nd_line(nd, e), "wrong number of field values for this struct")
        }
        return
    }
    if sk == SYM_VARIANT() {
        # A variant construction *is* the call shape -- `Circle(1.0)` is an
        # ordinary call whose callee names a variant -- so its arity is checked
        # here, beside the struct's, and for the same reason: a call with the
        # wrong number of values has to be a refusal with a line number, not a
        # surprise inside the interpreter or a wrong answer out of the back end.
        nf: int = vrb_get(mem, sv, VRB_NFIELD())
        if nf != nargs {
            fail_kind(path, nd_line(nd, e), "type error",
                      concat(concat(concat(concat(concat("variant '",
                                                        interned(vrb_get(mem, sv,
                                                                         VRB_NAME()))),
                                               "' carries "),
                                        ck_int_text(nf)),
                                 concat(" payload value(s), so it takes ", ck_int_text(nf))),
                              concat(", not ", ck_int_text(nargs))))
        }
        return
    }
    if sk == SYM_BUILTIN() {
        want: int = builtin_arity(sv)
        if want >= 0 {
            if want != nargs {
                fail(path, nd_line(nd, e), "wrong number of arguments for this builtin")
            }
        }
        return
    }
    fail(path, nd_line(nd, e), "this is not something that can be called")
}

def bind_name(nd: Array[int, 655360], mut mem: Array[int, 3741696], path: str,
              mut vm: VM, e: int) -> None {
    h: int = nd[e * 10 + 1]
    i: int = sc_find(mem, vm, h)
    if i >= 0 {
        nt_put(mem, e, NT_SYM(), sc_kind(mem, i))
        nt_put(mem, e, NT_VAL(), sc_val(mem, i))
        # a name carries its own kind, so the back end can print its C type
        # without a second symbol table
        nt_put(mem, e, NT_LIT(), sc_ckind(mem, i))
        # and its shape row, which is what a `match` reads to find its variants
        nt_put(mem, e, NT_ROW(), sc_shape(mem, i))
        return
    }
    b: int = builtin_id(h)
    if b > 0 {
        nt_put(mem, e, NT_SYM(), SYM_BUILTIN())
        nt_put(mem, e, NT_VAL(), b)
        return
    }
    # a bare variant name is a value: the one spelling that builds a payload-free
    # value, and the callee of a construction.  Both go through this arm, and
    # `SYM_VARIANT()` plus the variant record is everything the checker, the
    # interpreter and both back ends need to finish the job.
    vi: int = find_variant(mem, vm, h)
    if vi >= 0 {
        nt_put(mem, e, NT_SYM(), SYM_VARIANT())
        nt_put(mem, e, NT_VAL(), vi)
        nt_put(mem, e, NT_LIT(),
               pack_kind(K_ENUM(), enb_get(mem, vrb_get(mem, vi, VRB_ENUM()),
                                           ENB_SID())))
        nt_put(mem, e, NT_ROW(),
               enb_get(mem, vrb_get(mem, vi, VRB_ENUM()), ENB_SID()))
        return
    }
    if find_enum(mem, vm, h) >= 0 {
        # `Shape` alone is not a value, and "undeclared name 'Shape'" would send
        # the reader looking for a typo in a name the compiler knows perfectly well
        fail_kind(path, nd_line(nd, e), "type error",
                  concat(concat("enum '", interned(h)),
                         "' is a type, not a value: name one of its variants"))
    }
    fail_name(path, nd_line(nd, e), "undeclared name", interned(h))
}

def walk_expr(nd: Array[int, 655360], ty: Array[int, 262144],
              mut mem: Array[int, 3741696], path: str, mut vm: VM,
              e: int) -> None {
    if e <= 0 {
        return
    }
    k: int = nd_kind(nd, e)
    if k == 25 {
        bind_name(nd, mem, path, vm, e)
        return
    }
    if k == 26 {
        callee: int = nd[e * 10 + 1]
        walk_expr(nd, ty, mem, path, vm, callee)
        mut a: int = nd[e * 10 + 2]
        while a > 0 {
            walk_expr(nd, ty, mem, path, vm, a)
            a = nd_nx(nd, a)
        }
        check_call(nd, mem, path, vm, e, callee)
        return
    }
    if k == 27 {
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 2])
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 3])
        return
    }
    if k == 28 {
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 2])
        return
    }
    if k == 29 {
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 2])
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 3])
        return
    }
    if k == 30 {
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 2])
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 3])
        return
    }
    if k == 31 {
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 1])
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 2])
        return
    }
    if k == 32 {
        walk_expr(nd, ty, mem, path, vm, nd[e * 10 + 1])
        return
    }
    if k == 33 {
        mut a: int = nd[e * 10 + 1]
        while a > 0 {
            walk_expr(nd, ty, mem, path, vm, a)
            a = nd_nx(nd, a)
        }
        return
    }
    if k == 34 {
        # stage 0's own words for it (checker.py:1206), kept because a slice is
        # a *language* feature that is missing, not a typo the reader made
        fail_kind(path, nd_line(nd, e), "type error",
                  "slices are not implemented in Vela 0.1")
    }
    # 20 int, 21 float, 22 str, 23 bool, 24 none: nothing to bind
}

# -------------------------------------------------------- binding statements

def declare_local(nd: Array[int, 655360], ty: Array[int, 262144],
                  mut mem: Array[int, 3741696], path: str, mut vm: VM,
                  decl: int, tgt: int) -> None {
    if nd_kind(nd, tgt) != 25 {
        fail(path, nd_line(nd, decl), "a declaration needs a name on its left")
    }
    name: int = nd[tgt * 10 + 1]
    slot: int = vm.nlocal
    vm.nlocal += 1
    if vm.nlocal >= CELL_STACK_MAX() {
        fail(path, nd_line(nd, decl), "a function has too many local variables")
    }
    nt_put(mem, decl, NT_SLOT(), slot)
    t: int = nd[decl * 10 + 3]
    if t < 0 {
        # `mut a = 1` -- a binding with an initialiser and no annotation.  Nothing
        # in this compiler infers a binding's kind from its value, and the two
        # lines below would have answered with the type pool read at index -1:
        # `type_kind` returns early for a negative index, but `ty_len(ty, -1)` is
        # `ty[-1]` and the garbage that came back became the binding's packed kind
        # -- which is not a refusal but a *hang*.  `vm.exe check` never returned on
        # a four-line program, because the garbage kind reached a length-driven
        # loop downstream (measured 2026-09-24; the hang is in the 2026-09-20
        # binary too, so it predates every change in this tree's recent work).
        # A refusal is the honest answer: the language has no inference to do this
        # with yet, and it is a decision for SPEC, not for a repair here.
        fail(path, nd_line(nd, decl),
             ck_quoted("binding '", name,
                       "' has no type annotation: write the type after the name, as in `mut a: int = 1`"))
    }
    kind: int = type_kind(ty, t, mem, vm)
    mut ck: int = pack_kind(kind, ty_len(ty, t))
    mut sid: int = -1
    if kind == K_ST() {
        sid = struct_of_type(ty, t, mem, vm)
        if sid < 0 {
            fail(path, nd_line(nd, decl), "unknown struct type")
        }
        ck = pack_kind(K_ST(), sid)
    }
    if kind == K_ENUM() {
        # An enum binding is packed exactly like a struct one: the kind byte says
        # `K_ENUM` (so a `match` can tell the two apart, and the C back end can
        # spell the value) and the payload carries the row its values use (so
        # `Array[E, N]` has a stride and the interpreter has a cell count).
        sid = shape_of_type(ty, t, mem, vm)
        e: int = enum_of_type(ty, t, mem, vm)
        if sid < 0 or e < 0 {
            fail(path, nd_line(nd, decl), "unknown enum type")
        }
        ck = pack_kind(K_ENUM(), sid)
    }
    if kind == K_AX() {
        sid = struct_of_type(ty, ty_elem(ty, t), mem, vm)
        if sid < 0 {
            fail(path, nd_line(nd, decl), "unknown struct type")
        }
    }
    sc_push(mem, vm, name, SYM_LOCAL(), slot, ck, sid)
    nt_put(mem, decl, NT_LIT(), ck)
    nt_put(mem, decl, NT_VAL(), sid)
}

def walk_body(nd: Array[int, 655360], ty: Array[int, 262144],
              mut mem: Array[int, 3741696], path: str, mut vm: VM,
              head: int) -> None {
    mut s: int = head
    while s > 0 {
        walk_stmt(nd, ty, mem, path, vm, s)
        s = nd_nx(nd, s)
    }
}

# The shape row a packed kind names, or -1.  `K_ST` and `K_ENUM` both spend the
# packed payload word on that row; `K_AX` spends it on the array *length*, which
# the constant-index rule needs, so an array of enums used as a payload field
# reports no row rather than the wrong one.
def row_of_packed(packed: int) -> int {
    k: int = unpack_kind(packed)
    if k == K_ST() {
        return unpack_len(packed)
    }
    if k == K_ENUM() {
        return unpack_len(packed)
    }
    return -1
}

# One arm: `Circle(r) { ... }`, or `else { ... }` with no pattern at all.
#
# The bindings are the *variant's* payload fields, positionally, and each one
# becomes an ordinary local of the arm's block: the same frame slot a declaration
# gets, so neither the interpreter nor either back end needs a new notion of
# "bound".  Which variant a pattern names, and how many names it must bind, is
# decided here because this is the first pass that has the variant table; whether
# that variant belongs to the *subject's* enum is the checker's question, since
# only a type can answer it.
def walk_arm(nd: Array[int, 655360], ty: Array[int, 262144],
             mut mem: Array[int, 3741696], path: str, mut vm: VM,
             a: int) -> None {
    pat: int = nd[a * 10 + 1]
    mut vi: int = -1
    if pat >= 0 {
        vi = find_variant(mem, vm, pat)
        if vi < 0 {
            fail_kind(path, nd_line(nd, a), "type error",
                      concat(concat("no variant named '", interned(pat)),
                             "' in this program"))
        }
        nf: int = vrb_get(mem, vi, VRB_NFIELD())
        nb: int = nd[a * 10 + 3]
        if nf != nb {
            fail_kind(path, nd_line(nd, a), "type error",
                      concat(concat(concat(concat(concat("variant '",
                                                        interned(pat)),
                                               "' carries "), ck_int_text(nf)),
                                    concat(" payload value(s), so its pattern binds ",
                                           ck_int_text(nf))),
                             concat(" name(s), not ", ck_int_text(nb))))
        }
    }
    mark: int = vm.scn
    mut b: int = nd[a * 10 + 2]
    mut i: int = 0
    while b > 0 {
        fck: int = vfl_get(mem, vrb_get(mem, vi, VRB_FOFF()) + i * 2 + 1)
        frow: int = row_of_packed(fck)
        if vm.nlocal >= CELL_STACK_MAX() {
            fail(path, nd_line(nd, a), "a function has too many local variables")
        }
        slot: int = vm.nlocal
        vm.nlocal += 1
        sc_push(mem, vm, nd[b * 10 + 1], SYM_LOCAL(), slot, fck, frow)
        nt_put(mem, b, NT_SLOT(), slot)
        nt_put(mem, b, NT_LIT(), fck)
        nt_put(mem, b, NT_ROW(), frow)
        i += 1
        b = nd_nx(nd, b)
    }
    walk_body(nd, ty, mem, path, vm, nd[a * 10 + 4])
    vm.scn = mark
}

def walk_stmt(nd: Array[int, 655360], ty: Array[int, 262144],
              mut mem: Array[int, 3741696], path: str, mut vm: VM,
              s: int) -> None {
    k: int = nd_kind(nd, s)
    if k == 6 {
        tgt: int = nd[s * 10 + 1]
        if (nd[s * 10 + 6] & 2) == 2 {
            declare_local(nd, ty, mem, path, vm, s, tgt)
        } else {
            walk_expr(nd, ty, mem, path, vm, tgt)
        }
        v: int = nd[s * 10 + 2]
        if v > 0 {
            walk_expr(nd, ty, mem, path, vm, v)
        }
        return
    }
    if k == 7 {
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 1])
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 2])
        return
    }
    if k == 8 {
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 1])
        return
    }
    if k == 9 {
        v: int = nd[s * 10 + 1]
        if v > 0 {
            walk_expr(nd, ty, mem, path, vm, v)
        }
        return
    }
    if k == 10 {
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 1])
        mark: int = vm.scn
        walk_body(nd, ty, mem, path, vm, nd[s * 10 + 2])
        vm.scn = mark
        e: int = nd[s * 10 + 4]
        if e > 0 {
            # `else { ... }` is a block chain, `else if ...` is one nested if
            # node in the same word (parser.vel:589); walking the chain handles
            # both.  Word 8 is the else *count*, not the head.
            walk_body(nd, ty, mem, path, vm, e)
            vm.scn = mark
        }
        return
    }
    if k == 11 {
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 1])
        mark: int = vm.scn
        walk_body(nd, ty, mem, path, vm, nd[s * 10 + 2])
        vm.scn = mark
        return
    }
    if k == 12 {
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 2])
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 3])
        st: int = nd[s * 10 + 4]
        if st > 0 {
            walk_expr(nd, ty, mem, path, vm, st)
        }
        mark: int = vm.scn
        name: int = nd[s * 10 + 1]
        slot: int = vm.nlocal
        vm.nlocal += 1
        nt_put(mem, s, NT_SLOT(), slot)
        sc_push(mem, vm, name, SYM_LOCAL(), slot, K_INT(), -1)
        walk_body(nd, ty, mem, path, vm, nd[s * 10 + 8])
        vm.scn = mark
        return
    }
    if k == 37 {
        walk_expr(nd, ty, mem, path, vm, nd[s * 10 + 1])
        mut a: int = nd[s * 10 + 2]
        while a > 0 {
            walk_arm(nd, ty, mem, path, vm, a)
            a = nd_nx(nd, a)
        }
        return
    }
    if k == 35 {
        fail_kind(path, nd_line(nd, s), "type error",
                  "an enum is declared at the top level, not inside a block")
    }
    if k == 38 {
        # an arm chain is walked by the `match` that owns it; one reaching this
        # dispatcher would be a parser bug, and saying so beats binding nothing
        fail_kind(path, nd_line(nd, s), "type error",
                  "a match arm is legal inside a match only")
    }
    if k == 2 {
        # A `def` inside a body is neither a closure nor a forward declaration:
        # Vela 0.1 has one scope for functions, and refusing the nesting here is
        # what stage 0 does too (checker.py, "nested functions are not
        # supported") — left alone, the body would simply never be registered
        # and the first call to it would report a name that "does not exist" for
        # no visible reason.
        fail_kind(path, nd_line(nd, s), "type error",
                  "nested functions are not supported")
        return
    }
    # 13 break, 14 continue, 15 pass: nothing to bind, nothing to allocate
}

# --------------------------------------------------------------- entry point
#
# Two passes, in this order and not the other: every top-level name must be
# registered before any body is resolved, or a function could not call one
# defined below it — and a language where the order of definitions decides
# which ones are visible is a language with a trap in it.

def resolve_function(nd: Array[int, 655360], ty: Array[int, 262144],
                     mut mem: Array[int, 3741696], path: str, mut vm: VM,
                     fn: int) -> None {
    vm.scn = vm.nglob
    vm.nlocal = 0
    mut p: int = ft_get(mem, fn, FT_PARAM())
    while p > 0 {
        if vm.nlocal >= CELL_STACK_MAX() {
            fail(path, nd_line(nd, p), "too many parameters")
        }
        sc_push(mem, vm, nd[p * 10 + 1], SYM_LOCAL(), vm.nlocal,
                param_packed(nd, ty, mem, vm, p),
                shape_of_type(ty, nd[p * 10 + 2], mem, vm))
        vm.nlocal += 1
        p = nd_nx(nd, p)
    }
    body: int = ft_get(mem, fn, FT_BODY())
    # `extern c` declarations have no body: `-1` is not a node, and walking one
    # would be walking a statement that does not exist
    if body >= 0 {
        walk_body(nd, ty, mem, path, vm, body)
    }
    ft_put(mem, fn, FT_NLOCAL(), vm.nlocal)
}

def resolve_module(nd: Array[int, 655360], ty: Array[int, 262144],
                   mut mem: Array[int, 3741696], path: str,
                   mut vm: VM) -> None {
    # Pass 1: every top-level *name*.  An enum registers its own name and the
    # layout row its values use, but not its variants -- a payload field may name
    # an enum that is declared below this one, and a table that is complete before
    # any field type is resolved is what makes that ordering legal.  The stride
    # needs no types (every payload field is one cell) so it can be finished here.
    mut s: int = nd[1]
    while s > 0 {
        k: int = nd_kind(nd, s)
        if k == 2 {
            add_function(nd, mem, path, vm, s, -1)
        } else if k == 4 {
            add_struct(nd, ty, mem, path, vm, s)
        } else if k == 35 {
            add_enum_names(nd, mem, path, vm, s)
        } else {
            fail(path, nd_line(nd, s),
                 "a top-level statement must be a function, a struct or an enum")
        }
        s = nd_nx(nd, s)
    }
    # Pass 1b: now that the names are in, the variants -- names, tags, and payload
    # field types.
    s = nd[1]
    while s > 0 {
        if nd_kind(nd, s) == 35 {
            add_enum_variants(nd, ty, mem, path, vm, s)
        }
        s = nd_nx(nd, s)
    }
    vm.nglob = vm.scn
    check_variants_visible(mem, path, vm)
    mut f: int = 0
    while f < vm.nfn {
        resolve_function(nd, ty, mem, path, vm, f)
        f += 1
    }
}
