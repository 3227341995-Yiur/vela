# tools/link_selfhost.vel 鈥?splice the self-hosted parts into one Vela file.
#
# Vela 0.1 has no module system (`import` is reserved and unimplemented), so a
# multi-file Vela program is a build-time concatenation 鈥?the same trick C plays
# with `#include`, and it disappears the day Vela grows modules.  This used to be
# tools/link_selfhost.py; it is written in Vela now, because a toolchain that
# needs Python to assemble its own compiler is a toolchain that has not finished
# bootstrapping.
#
# The lexer is already a program of its own (selfhost/vela.vel), so only its
# front half is taken: everything above its `# driver` section, which is where
# the standalone lexer's own `main` lives.  The parts then supply the shared
# interpreter state, the parser, the resolver, the checker, the evaluator, the
# C11 emitter, the syntax-tree dumper and the driver that puts them behind one
# command.
#
#     selfhost/build/vm.exe build tools/link_selfhost.vel   # build the linker
#     tools/link_selfhost.exe                                # write selfhost/vm.vel
#     tools/link_selfhost.exe --check                        # is it up to date?
#
# It is built and then run, not interpreted, and that is not a detail: the
# interpreter's `str` is a handle into a fixed table, so a program that assembles
# a 338 KB file out of a thousand concatenations exhausts it ("string table
# full"), while the same program compiled has no table to exhaust.
#
# The step after this one is what makes it self-hosting:
#
#     selfhost/build/vm.exe build selfhost/vm.vel
#
# which compiles the linked compiler with the compiler that exists.

def lexer_path() -> str { return "selfhost/vela.vel" }
def parts_dir() -> str { return "selfhost/parts/" }
def out_path() -> str { return "selfhost/vm.vel" }
def driver_marker() -> str { return "\n# driver\n" }

# The parts, in dependency order: state first (every part below uses its node
# and token layout), then the pipeline, then the driver that calls it.
def part_count() -> int { return 9 }

def part_name(i: int) -> str {
    if i == 0 { return "vm_state.vel" }
    if i == 1 { return "parser.vel" }
    if i == 2 { return "resolve.vel" }
    if i == 3 { return "check.vel" }
    if i == 4 { return "eval.vel" }
    if i == 5 { return "emit.vel" }
    # Before `dump` and `vm_main`, because a function has to be declared before it is
    # called and the driver's new modes will call the shim.  It declares the interface
    # to the compiler's own code generator (`runtime/vela_llvm_shim.h`, generated into
    # this file by tools/gen-shim-decls.ps1): the functions are `extern c`, so this
    # part adds prototypes and nothing to link -- until `build.ps1` links the shim in.
    if i == 6 { return "llvm_shim.vel" }
    if i == 7 { return "dump.vel" }
    if i == 8 { return "vm_main.vel" }
    return ""
}

def banner() -> str {
    return "# ============================================================================\n# selfhost/vm.vel - GENERATED by tools/link_selfhost.vel.  Do not edit: edit\n# the parts and re-link.\n#\n# The self-hosted front end of Vela, in one file because Vela 0.1 has no module\n# system: the lexer (from selfhost/vela.vel), then the interpreter's shared\n# state, the parser, the resolver, the checker, the evaluator, the C11 emitter,\n# the syntax-tree dumper, and the driver that puts them behind one command.\n#\n#     selfhost/build/vm.exe build tools/link_selfhost.vel && tools/link_selfhost.exe\n#     selfhost/build/vm.exe build selfhost/vm.vel\n#     selfhost/build/vm.exe lex   bench/matmul.vel\n#     selfhost/build/vm.exe parse selfhost/parts/parser.vel\n#     selfhost/build/vm.exe run   tests/build/recursion_fib.vel\n# ============================================================================\n\n"
}

# ------------------------------------------------------------------ text tools

def is_space(c: int) -> bool {
    if c == 32 { return True }
    if c == 9 { return True }
    if c == 10 { return True }
    if c == 13 { return True }
    return False
}

# Trailing whitespace off, the way a text tool does it: a part file that ends in
# three blank lines is not three blank lines of the linked compiler.
def rstrip(s: str) -> str {
    mut e: int = len(s)
    while e > 0 {
        if not is_space(bytes_at(s, e - 1)) {
            break
        }
        e -= 1
    }
    return substr(s, 0, e)
}

# The first index of `needle` in `s`, or -1.  There is no `find` in the language
# and there does not need to be: this is four lines and it is the only search the
# toolchain does.
def find(s: str, needle: str) -> int {
    n: int = len(needle)
    if n == 0 { return 0 }
    mut i: int = 0
    while i + n <= len(s) {
        if substr(s, i, i + n) == needle {
            return i
        }
        i += 1
    }
    return 0 - 1
}

def n_nl(s: str) -> int {
    mut n: int = 0
    mut i: int = 0
    while i < len(s) {
        if bytes_at(s, i) == 10 {
            n += 1
        }
        i += 1
    }
    return n
}

# `===== selfhost/parts/check.vel =========================...` 鈥?the rule shortens
# as the name grows so every header line is the same width, which is what makes
# `grep -n '^# ====' selfhost/vm.vel` a table of contents.
def rule(n: int) -> str {
    mut k: int = 66 - n
    if k < 4 {
        k = 4
    }
    mut r: str = ""
    mut i: int = 0
    while i < k {
        r = concat(r, "=")
        i += 1
    }
    return r
}

def part_header(name: str) -> str {
    return concat(concat("\n# ==== ", concat(parts_dir(), name)), concat(" ", concat(rule(len(name)), "\n")))
}

# ---------------------------------------------------------------------- build

def link() -> str {
    src: str = read_text(lexer_path())
    if len(src) == 0 {
        panic("link_selfhost: cannot read selfhost/vela.vel")
    }
    at: int = find(src, driver_marker())
    if at < 0 {
        panic("link_selfhost: selfhost/vela.vel has no '# driver' marker - did the lexer's driver section move?")
    }
    mut out: str = banner()
    out = concat(out, concat(rstrip(substr(src, 0, at)), "\n"))
    mut i: int = 0
    while i < part_count() {
        name: str = part_name(i)
        body: str = read_text(concat(parts_dir(), name))
        if len(body) == 0 {
            panic(concat("link_selfhost: cannot read ", concat(parts_dir(), name)))
        }
        out = concat(out, part_header(name))
        out = concat(out, concat(rstrip(body), "\n"))
        i += 1
    }
    return out
}

def main() -> None {
    mut check: bool = False
    if argc() >= 2 {
        # arg(0) is the program's own name; the first argument typed is arg(1)
        if arg(1) == "--check" {
            check = True
        }
    }
    text: str = link()
    if check {
        have: str = read_text(out_path())
        if have == text {
            emit_str(out_path())
            emit_str(" is up to date")
            emit_nl()
            return
        }
        warn_str("link_selfhost: ")
        warn_str(out_path())
        warn_str(" is stale: run `vm.exe run tools/link_selfhost.vel`")
        warn_nl()
        panic("the linked compiler is out of date")
    }
    if not write_text(out_path(), text) {
        panic("link_selfhost: could not write selfhost/vm.vel")
    }
    emit_str("linked ")
    emit_str(out_path())
    emit_str(": ")
    emit_int(n_nl(text))
    emit_str(" lines, ")
    emit_int(len(text))
    emit_str(" bytes")
    emit_nl()
}
