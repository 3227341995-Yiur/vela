def main() -> None {
    print("hello from Vela")
    mut total: int = 0
    for i in range(0, 100) {
        total += i
    }
    print("sum 0..99 =", total)
    mut xs: Array[float, 8] = [1.0, 2.0, 3.0]
    for i in range(0, len(xs)) {
        xs[i] = xs[i] * xs[i]
    }
    print("xs[7] =", xs[7])
    print("xs[2] =", xs[2])
}
